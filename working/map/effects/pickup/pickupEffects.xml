            <effectMesh node="0|0|11" numRows="24" rowLength="25" skipPositions="0" boundingBox="5 5 5"/>
        </effectMeshes>

        <effectMaterials rootNode="0|1">
            <effectMaterial node="0|1|0" fillTypes="STRAW WHEAT_CUT BARLEY_CUT OAT_CUT CANOLA_CUT SOYBEAN_CUT" />
            <effectMaterial node="0|1|1" fillTypes="SILAGE" />
            <effectMaterial node="0|1|2" fillTypes="GRASS_WINDROW" />
