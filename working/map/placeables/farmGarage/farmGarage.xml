<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="garageSolarPanels" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_storeItem_bricksShed</name>
        <functions>
            <function>$l10n_function_garage</function>
        </functions>
        <image>map/placeables/farmGarage/store_farmGarage.dds</image>
        <price>50000</price>
        <dailyUpkeep>40</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>sheds</category>
        <brush>
            <type>placeable</type>
            <category>buildings</category>
            <tab>sheds</tab>
        </brush>
		<canBeSold>true</canBeSold>
        <showInStore>false</showInStore>
    </storeData>

    <base>
        <filename>map/placeables/farmGarage/farmGarage.i3d</filename>
        <boughtWithFarmland>true</boughtWithFarmland>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01" />
        </testAreas>
        <sounds>
            <place template="smallImp" />
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30">
        <levelAreas>
            <levelArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01" groundType="asphalt"/>
        </levelAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01" />
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
        </updateAreas>
    </ai>

    <dynamicallyLoadedParts>
        <dynamicallyLoadedPart filename="$data/shared/assets/lights/rudolfHormann/powerSwitch.i3d"        node="0"   linkNode="lightSwitch" />
        <dynamicallyLoadedPart filename="$data/shared/assets/lights/rudolfHormann/powerSwitch.i3d"        node="0"   linkNode="lightSwitch02" />
        <dynamicallyLoadedPart filename="$data/placeables/mapEU/brandless/buildings/farmGarage/props.i3d" node="0|1" linkNode="farmGarage" />
    </dynamicallyLoadedParts>

    <lights>
        <sharedLight filename="$data/shared/assets/lights/lizard/buildings/industrialLight02.xml" linkNode="industrialLight02_01" groupIndex="1" />
        <sharedLight filename="$data/shared/assets/lights/lizard/buildings/industrialLight02.xml" linkNode="industrialLight02_02" groupIndex="1" />
        <sharedLight filename="$data/shared/assets/lights/lizard/buildings/industrialLight02.xml" linkNode="industrialLight02_03" groupIndex="1" />
        <sharedLight filename="$data/shared/assets/lights/lizard/buildings/industrialLight02.xml" linkNode="industrialLight02_04" groupIndex="1" />
        <sharedLight filename="$data/shared/assets/lights/lizard/buildings/industrialLight02.xml" linkNode="industrialLight02_05" groupIndex="1" />
        
        <realLights>
            <low>
                <light node="realLightsLow" groupIndex="1"/>
            </low>
            <high>
                <light node="realLightsHigh" groupIndex="1"/>
            </high>
        </realLights>

        <group name="$l10n_action_placeableLightShed" triggerNode="lightTrigger">
            <sounds>
                <toggle template="lizardFloodLight" innerRadius="50" outerRadius="100" volumeScale="0.2"/>
            </sounds>
        </group>
    </lights>

    <animatedObjects>
        <animatedObject saveId="door01">
            <animation duration="3">
                <part node="door01">
                    <keyFrame time="0.0" translation="0 0 0"/>
                    <keyFrame time="1.0" translation="5 0 0"/>
                </part>
                <part node="occluderDoor01">
                    <keyFrame time="0"    visibility="true" />
                    <keyFrame time="0.01" visibility="false" />
                </part>
            </animation>
            <controls triggerNode="doorTrigger01" posAction="ACTIVATE_HANDTOOL" posText="action_openGate" negText="action_closeGate"/>
            <sounds>
                <moving linkNode="door01" template="slidingGateMetalLoop"  pitchScale="1" fadeIn="0.1"/>
                <posEnd linkNode="door01" template="slidingGateMetalOpen"  pitchScale="0.9" />
                <negEnd linkNode="door01" template="slidingGateMetalClose" pitchScale="1.0" />
            </sounds>
        </animatedObject>
        <animatedObject saveId="door02">
            <animation duration="3">
                <part node="door02">
                    <keyFrame time="0.0" translation="0 0 0"/>
                    <keyFrame time="1.0" translation="-5 0 0"/>
                </part>
                <part node="occluderDoor02">
                    <keyFrame time="0"    visibility="true" />
                    <keyFrame time="0.01" visibility="false" />
                </part>
            </animation>
            <controls triggerNode="doorTrigger02" posAction="ACTIVATE_HANDTOOL" posText="action_openGate" negText="action_closeGate"/>
            <sounds>
                <moving linkNode="door02" template="slidingGateMetalLoop"  pitchScale="1" fadeIn="0.1"/>
                <posEnd linkNode="door02" template="slidingGateMetalOpen"  pitchScale="0.9" />
                <negEnd linkNode="door02" template="slidingGateMetalClose" pitchScale="1.0" />
            </sounds>
        </animatedObject>
    </animatedObjects>

    <!--<solarPanels>
        <solarPanelsConfigurations>
            <solarPanelsConfiguration name="$l10n_ui_no" isActive="false">
                <objectChange node="solarPanel" visibilityActive="false"/>
            </solarPanelsConfiguration>

            <solarPanelsConfiguration name="$l10n_ui_yes" isActive="true" price="70500" incomePerHour="245" />
        </solarPanelsConfigurations>
    </solarPanels>-->

    <i3dMappings>
        <i3dMapping id="farmGarage" node="0>" />
        <i3dMapping id="clearAreaStart01" node="0>0|0" />
        <i3dMapping id="clearAreaWidth01" node="0>0|0|0" />
        <i3dMapping id="clearAreaHeight01" node="0>0|0|1" />
        <i3dMapping id="indoorAreaStart01" node="0>1|0" />
        <i3dMapping id="indoorAreaWidth01" node="0>1|0|0" />
        <i3dMapping id="indoorAreaHeight01" node="0>1|0|1" />
        <i3dMapping id="testAreaStart01" node="0>2|0" />
        <i3dMapping id="testAreaEnd01" node="0>2|0|0" />
        <i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>3|0" />
        <i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>3|0|0" />
        <i3dMapping id="solarPanel" node="0>4|2" />
        <i3dMapping id="door01" node="0>5|0|0" />
        <i3dMapping id="collision" node="0>5|0|0|0" />
        <i3dMapping id="door02" node="0>5|1|0" />
        <i3dMapping id="doorTrigger02" node="0>5|2" />
        <i3dMapping id="doorTrigger01" node="0>5|3" />
        <i3dMapping id="realLightsLow" node="0>6|0|0" />
        <i3dMapping id="realLightsHigh" node="0>6|0|1" />
        <i3dMapping id="industrialLight02_01" node="0>6|1|0" />
        <i3dMapping id="industrialLight02_02" node="0>6|1|1" />
        <i3dMapping id="industrialLight02_03" node="0>6|1|2" />
        <i3dMapping id="industrialLight02_04" node="0>6|1|3" />
        <i3dMapping id="industrialLight02_05" node="0>6|1|4" />
        <i3dMapping id="lightSwitch" node="0>6|2" />
		<i3dMapping id="lightSwitch02" node="0>6|4" />
        <i3dMapping id="lightTrigger" node="0>6|3" />
        <i3dMapping id="occluderDoor01" node="0>9" />
        <i3dMapping id="occluderDoor02" node="0>10" />
    </i3dMappings>
</placeable>
