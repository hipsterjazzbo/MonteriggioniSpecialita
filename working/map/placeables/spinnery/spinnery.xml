<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="productionPoint" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_shopItem_spinnery</name>
        <functions>
            <function>$l10n_function_productionPoint</function>
        </functions>
        <image>map/placeables/spinnery/store_spinnery.png</image>
        <price>180000</price>
		<dailyUpkeep>500</dailyUpkeep>
        <showInStore>false</showInStore>
        <canBeSold>true</canBeSold>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>productionPoints</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>factories</tab>
        </brush>
    </storeData>

    <base>
        <filename>map/placeables/spinnery/spinnery.i3d</filename>
        <canBeRenamed>false</canBeRenamed>
        <canBeDeleted>false</canBeDeleted>
    </base>


    <clearAreas/>
    <leveling/>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01" />
        <indoorArea startNode="indoorAreaStart02" widthNode="indoorAreaWidth02" heightNode="indoorAreaHeight02" />
    </indoorAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
        </updateAreas>
    </ai>

    <infoTrigger triggerNode="infoTrigger" />

    <dynamicallyLoadedParts>
    </dynamicallyLoadedParts>

    <productionPoint>
        <productions>
            <production id="fabric_wool" name="%s %s" params="$l10n_fillType_fabric|$l10n_fillType_wool" cyclesPerHour="60" costsPerActiveHour="5">
                <inputs>
                    <input fillType="WOOL" amount="3" />
                </inputs>
                <outputs>
                    <output fillType="FABRIC" amount="1" />
                </outputs>
            </production>
            <production id="fabric_cotton" name="%s %s" params="$l10n_fillType_fabric|$l10n_fillType_cotton" cyclesPerHour="100" costsPerActiveHour="5">
                <inputs>
                    <input fillType="COTTON" amount="9" />
                </inputs>
                <outputs>
                    <output fillType="FABRIC" amount="3" />
                </outputs>
            </production>
			<production id="grape_leatherette" name="$l10n_fillType_grapeleatherette" cyclesPerHour="90" costsPerActiveHour="5">
                <inputs>
                    <input fillType="GRAPEMUST" amount="5" />
					<input fillType="POLYESTER" amount="1.5" />
                </inputs>
                <outputs>
                    <output fillType="GRAPELEATHER" amount="6" />
                </outputs>
            </production>
        </productions>

        <storage isExtension="false" fillLevelSyncThreshold="50">
            <capacity fillType="WOOL"   capacity="45000" />
            <capacity fillType="COTTON" capacity="200000" />
			<capacity fillType="GRAPEMUST" capacity="45000" />
			<capacity fillType="POLYESTER" capacity="45000" />
            <capacity fillType="FABRIC" capacity="50000" />
            <capacity fillType="GRAPELEATHER" capacity="50000" />	
        </storage>

        <sellingStation node="sellingStation" supportsExtension="false" appearsOnStats="true">
            <palletTrigger triggerNode="palletTrigger" aiNode="unloadTriggerAINode" fillTypes="WOOL COTTON GRAPEMUST POLYESTER" />
            <baleTrigger triggerNode="baleTrigger" deleteLitersPerSecond="4000" aiNode="unloadTriggerAINode" fillTypes="WOOL COTTON"/>
        </sellingStation>

        <palletSpawner>
            <spawnPlaces>
                <spawnPlace startNode="palletAreaStart01" endNode="palletAreaEnd01"/>
                <spawnPlace startNode="palletAreaStart02" endNode="palletAreaEnd02"/>
            </spawnPlaces>
        </palletSpawner>

        <playerTrigger node="playerTrigger" />
        <sounds>
            <idle   template="spinneryIdle" linkNode="0>" />
            <active template="spinneryWork" linkNode="0>" />
        </sounds>
    </productionPoint>

    <triggerMarkers>
        <triggerMarker node="warningStripes01"/>
        <triggerMarker node="warningStripes02"/>
        <triggerMarker node="playerTriggerMarker"  adjustToGround="true" filename="$data/shared/assets/marker/markerIconWrench.i3d"/>
        <triggerMarker node="unloadTriggerMarker1" adjustToGround="true" filename="$data/shared/assets/marker/markerIconBales.i3d"/>
        <triggerMarker node="unloadTriggerMarker2" adjustToGround="true" filename="$data/shared/assets/marker/markerIconPallet.i3d"/>
    </triggerMarkers>

    <hotspots>
        <hotspot type="PRODUCTION_POINT" linkNode="unloadTriggerMarker1" teleportNode="playerTriggerMarker" />
    </hotspots>

    <i3dMappings>
        <i3dMapping id="spinnery" node="0>" />
        <i3dMapping id="clearAreaStart01" node="0>0|0" />
        <i3dMapping id="clearAreaWidth01" node="0>0|0|0" />
        <i3dMapping id="clearAreaHeight01" node="0>0|0|1" />
        <i3dMapping id="testAreaStart01" node="0>1|0" />
        <i3dMapping id="testAreaEnd01" node="0>1|0|0" />
        <i3dMapping id="indoorAreaStart01" node="0>2|0" />
        <i3dMapping id="indoorAreaWidth01" node="0>2|0|0" />
        <i3dMapping id="indoorAreaHeight01" node="0>2|0|1" />
        <i3dMapping id="indoorAreaStart02" node="0>2|1" />
        <i3dMapping id="indoorAreaWidth02" node="0>2|1|0" />
        <i3dMapping id="indoorAreaHeight02" node="0>2|1|1" />
        <i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>3|0" />
        <i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>3|0|0" />
        <i3dMapping id="infoTrigger" node="0>4" />
        <i3dMapping id="sellingStation" node="0>5" />
        <i3dMapping id="palletTrigger" node="0>5|0" />
        <i3dMapping id="warningStripes_unloading" node="0>5|1" />
        <i3dMapping id="warningStripes02" node="0>5|1|0" />
        <i3dMapping id="baleTrigger" node="0>5|2" />
        <i3dMapping id="baleTriggerAINode" node="0>5|2|0" />
        <i3dMapping id="unloadTriggerMarker1" node="0>5|3" />
        <i3dMapping id="unloadTriggerMarker2" node="0>5|4" />
        <i3dMapping id="unloadTriggerAINode" node="0>5|5" />
        <i3dMapping id="productionPoint" node="0>6" />
        <i3dMapping id="playerTrigger" node="0>6|0" />
        <i3dMapping id="playerTriggerMarker" node="0>6|0|0" />
        <i3dMapping id="palletSpawner" node="0>7" />
        <i3dMapping id="palletAreaStart01" node="0>7|0" />
        <i3dMapping id="palletAreaEnd01" node="0>7|0|0" />
        <i3dMapping id="palletAreaStart02" node="0>7|1" />
        <i3dMapping id="palletAreaEnd02" node="0>7|1|0" />
        <i3dMapping id="warningStripes01" node="0>7|2" />
    </i3dMappings>
</placeable>
