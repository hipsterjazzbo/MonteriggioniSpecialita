<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="farmhouse" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_object_farmhouse</name>
        <functions>
            <function>$l10n_function_farmHouse</function>
        </functions>
        <image>map/placeables/farmhouse_02/store_farmhouse02.dds</image>
		<canBeSold>false</canBeSold>
        <showInStore>false</showInStore>
        <price>10000</price>
        <dailyUpkeep>50</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>farmhouses</category>
        <brush>
            <type>placeable</type>
            <category>buildings</category>
            <tab>farmhouses</tab>
        </brush>

    </storeData>

    <base>
        <filename>map/placeables/farmhouse_02/farmhouseFeatures.i3d</filename>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
        </testAreas>
        <sounds>
            <place template="largeImp" />
        </sounds>
    </placement>

    <clearAreas>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30">
        <levelAreas>
        </levelAreas>
    </leveling>

    <indoorAreas>
    </indoorAreas>

    <tipOcclusionUpdateAreas>
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas/>
    </ai>

    <dynamicallyLoadedParts>

    </dynamicallyLoadedParts>

    <hotspots>
        <hotspot type="FARM" linkNode="0>" teleportNode="spawnPoint" />
    </hotspots>

    <triggerMarkers>
        <triggerMarker node="sleepTriggerMarker"    filename="$data/shared/assets/marker/markerIconSleep.i3d"/>
        <triggerMarker node="wardrobeTriggerMarker" filename="$data/shared/assets/marker/markerIconWardrobe.i3d"/>
    </triggerMarkers>

    <farmhouse spawnNode="spawnPoint">
        <sleeping triggerNode="sleepingTrigger" cameraNode="sleepCamera"/>
    </farmhouse>

    <wardrobe triggerNode="wardrobeTrigger"/>

    <i3dMappings>
        <i3dMapping id="farmhouseFeatures" node="0>" />
        <i3dMapping id="sleepCamera" node="0>0" />
        <i3dMapping id="sleepingTrigger" node="0>3" />
        <i3dMapping id="sleepTriggerMarker" node="0>1" />
        <i3dMapping id="spawnPoint" node="0>2" />
        <i3dMapping id="wardrobeTrigger" node="0>5" />
        <i3dMapping id="wardrobeTriggerMarker" node="0>4" />

    </i3dMappings>
</placeable>
