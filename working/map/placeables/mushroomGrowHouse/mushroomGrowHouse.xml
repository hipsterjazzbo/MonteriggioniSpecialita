            <production id="napaCabbage_fertilizer" name="%s (%s)" params="$l10n_fillType_napaCabbage|$l10n_fillType_fertilizer" cyclesPerHour="22" costsPerActiveHour="0.1">
                <inputs>
                    <input fillType="WATER" amount="8" />
                    <input fillType="SEEDS" amount="2" />
                    <input fillType="FERTILIZER" amount="1" />
                </inputs>
                <outputs>
                    <output fillType="NAPACABBAGE" amount="24" />
                </outputs>
            </production>
            <production id="napaCabbage_manure" name="%s (%s)" params="$l10n_fillType_napaCabbage|$l10n_fillType_manure" cyclesPerHour="22" costsPerActiveHour="0.1">
                <inputs>
