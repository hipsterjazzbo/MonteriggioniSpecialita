            <production id="specialita_asparagus_green" name="Green asparagus" cyclesPerHour="18" costsPerActiveHour="0.2"><inputs><input fillType="WATER" amount="10"/><input fillType="SEEDS" amount="2"/><input fillType="FERTILIZER" amount="1"/></inputs><outputs><output fillType="ASPARAGUS_GREEN" amount="10"/></outputs></production>
