        <sellingStation node="sellingStation" appearsOnStats="true" supportsExtension="false">
            <unloadTrigger exactFillRootNode="exactFillRootNode" fillTypes="WATER FERTILIZER SEEDS" aiNode="unloadTriggerAINode"/>
			<unloadTrigger exactFillRootNode="exactFillRootNode2" fillTypes="MANURE COMPOST" aiNode="unloadTriggerAINode2"/>
        </sellingStation>

        <loadingStation fillTypes="WATER" supportsExtension="true" />
		<loadingStation fillTypes="MANURE COMPOST" supportsExtension="true" />
        <loadingStation fillTypes="FERTILIZER" supportsExtension="true" />
        <loadingStation fillTypes="SEEDS" supportsExtension="true" />

        <palletSpawner>
            <spawnPlaces>
                <spawnPlace startNode="spawnPlaceStart01" endNode="spawnPlaceEnd01" />
            </spawnPlaces>
        </palletSpawner>

        <storage node="storage" isExtension="false" fillTypes="WATER" fillLevelSyncThreshold="10" >
            <capacity fillType="WATER"        capacity="10000" />
            <capacity fillType="LETTUCE"      capacity="14000" />
            <capacity fillType="TOMATO"       capacity="14000" />
            <capacity fillType="STRAWBERRY"   capacity="14000" />
            <capacity fillType="SPRING_ONION" capacity="14000" />
            <capacity fillType="NAPACABBAGE"  capacity="14000" />
            <capacity fillType="CHILLI"       capacity="14000" />
            <capacity fillType="GARLIC"       capacity="14000" />
			<capacity fillType="PEPPER" capacity="14000" /><capacity fillType="EGGPLANT" capacity="14000" /><capacity fillType="ASPARAGUS_WHITE" capacity="14000" /><capacity fillType="ASPARAGUS_GREEN" capacity="14000" />
