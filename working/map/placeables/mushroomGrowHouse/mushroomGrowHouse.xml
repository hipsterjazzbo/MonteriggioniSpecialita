                    <input fillType="SEEDS" amount="1" />
                    <input fillType="MANURE" amount="4" />
                </inputs>
                <outputs>
                    <output fillType="TOMATO" amount="8" />
                </outputs>
            </production>
            <production id="lettuce_fertilizer" name="%s (%s)" params="$l10n_fillType_lettuce|$l10n_fillType_fertilizer" cyclesPerHour="22" costsPerActiveHour="0.1">
