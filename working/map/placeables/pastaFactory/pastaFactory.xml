<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="productionPoint" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_storeItem_pastaFactory</name>
        <functions>
            <function>$l10n_function_productionPoint</function>
        </functions>
        <image>map/placeables/pastaFactory/store_pastaFactory.png</image>
        <price>100000</price>
		<dailyUpkeep>500</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>productionPoints</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>factories</tab>
        </brush>
    </storeData>

    <base>
        <filename>map/placeables/pastaFactory/pastaFactory.i3d</filename>
        <canBeRenamed>true</canBeRenamed>
		<boughtWithFarmland>false</boughtWithFarmland>
        <canBeDeleted>false</canBeDeleted>
    </base>
	
	<placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testArea1Start" endNode="testArea1End"/>
        </testAreas>

        <sounds>
            <place template="smallImp" />
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30">
        <levelAreas>
            <levelArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01" groundType="dirt"/>
        </levelAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01" />
        <indoorArea startNode="indoorAreaStart02" widthNode="indoorAreaWidth02" heightNode="indoorAreaHeight02" />
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
        </updateAreas>
    </ai>

    <infoTrigger triggerNode="infoTrigger" />

    <dynamicallyLoadedParts>
        <dynamicallyLoadedPart filename="$data/placeables/shared/sellingStationGeneric/sellingStationGenericNoCoverWideGrid.i3d" node="0" linkNode="exactFillNode" rotation="0 90 0" />
		<dynamicallyLoadedPart filename="$data/effects/chimneySmoke/smokeTrailSubUV.i3d"                                         node="1" linkNode="smoke01" shaderParameterName="colorAlpha" shaderParameter="0.5 0.5 0.5 0.5" position="0 -0.2 0"/>
	</dynamicallyLoadedParts>

    <productionPoint>
        <productions sharedThroughputCapacity="false">
            <production id="pasta" name="$l10n_fillType_pasta" cyclesPerHour="3" costsPerActiveHour="3">
                <inputs>
                    <input fillType="FLOUR" amount="90" />
                </inputs>
                <outputs>
                    <output fillType="PASTA" amount="100" />
                </outputs>
            </production>
			<production id="gnocchi" name="$l10n_fillType_gnocchi" cyclesPerHour="5" costsPerActiveHour="5">
                <inputs>
                    <input fillType="FLOUR" amount="30" />
					<input fillType="POTATO" amount="100" />
                </inputs>
                <outputs>
                    <output fillType="GNOCCHI" amount="100" />
                </outputs>
            </production>
			<production id="tricolore" name="$l10n_fillType_tricolore" cyclesPerHour="3" costsPerActiveHour="3">
                <inputs>
                    <input fillType="FLOUR" amount="50" />
					<input fillType="TOMATO" amount="25" />
					<input fillType="SPINACH" amount="25" />
                </inputs>
                <outputs>
                    <output fillType="TRICOLORE" amount="100" />
                </outputs>
            </production>
            <production id="pastaUovo" name="$l10n_fillType_pastaUovo" cyclesPerHour="3" costsPerActiveHour="3">
                <inputs>
                    <input fillType="FLOUR" amount="80" />
					<input fillType="EGG" amount="10" />
                </inputs>
                <outputs>
                    <output fillType="PASTAUOVO" amount="90" />
                </outputs>
            </production>
            <production id="passata" name="$l10n_fillType_passata" cyclesPerHour="8" costsPerActiveHour="3"><inputs><input fillType="TOMATO" amount="20"/></inputs><outputs><output fillType="PASSATA" amount="16"/></outputs></production>
            <production id="sugoPomodoro" name="$l10n_fillType_sugoPomodoro" cyclesPerHour="6" costsPerActiveHour="3"><inputs><input fillType="TOMATO" amount="15"/><input fillType="OLIVE_OIL" amount="2"/><input fillType="GARLIC" amount="1"/></inputs><outputs><output fillType="SUGO_AL_POMODORO" amount="14"/></outputs></production>
            <production id="arrabbiata" name="$l10n_fillType_arrabbiata" cyclesPerHour="6" costsPerActiveHour="3"><inputs><input fillType="TOMATO" amount="15"/><input fillType="OLIVE_OIL" amount="2"/><input fillType="CHILLI" amount="2"/></inputs><outputs><output fillType="ARRABBIATA" amount="14"/></outputs></production>
            <production id="marinara" name="$l10n_fillType_marinara" cyclesPerHour="6" costsPerActiveHour="3"><inputs><input fillType="TOMATO" amount="15"/><input fillType="OLIVE_OIL" amount="2"/><input fillType="GARLIC" amount="1"/><input fillType="BASIL" amount="1"/></inputs><outputs><output fillType="MARINARA" amount="14"/></outputs></production>
            <production id="sugoFunghi" name="$l10n_fillType_sugoFunghi" cyclesPerHour="6" costsPerActiveHour="3"><inputs><input fillType="OYSTER" amount="8"/><input fillType="TOMATO" amount="8"/><input fillType="OLIVE_OIL" amount="2"/></inputs><outputs><output fillType="SUGO_AI_FUNGHI" amount="14"/></outputs></production>
            <production id="pesto" name="$l10n_fillType_pesto" cyclesPerHour="6" costsPerActiveHour="3"><inputs><input fillType="BASIL" amount="6"/><input fillType="OLIVE_OIL" amount="2"/><input fillType="CHEESE" amount="2"/></inputs><outputs><output fillType="PESTO" amount="8"/></outputs></production>
            <production id="pestoRosso" name="$l10n_fillType_pestoRosso" cyclesPerHour="6" costsPerActiveHour="3"><inputs><input fillType="BASIL" amount="4"/><input fillType="TOMATO" amount="8"/><input fillType="OLIVE_OIL" amount="2"/></inputs><outputs><output fillType="PESTO_ROSSO" amount="10"/></outputs></production>
            <production id="preservedPeppers" name="$l10n_fillType_preservedPeppers" cyclesPerHour="6" costsPerActiveHour="3"><inputs><input fillType="PEPPER" amount="12"/><input fillType="OLIVE_OIL" amount="2"/></inputs><outputs><output fillType="PRESERVED_PEPPERS" amount="10"/></outputs></production>
            <production id="garlicInOil" name="$l10n_fillType_garlicInOil" cyclesPerHour="6" costsPerActiveHour="3"><inputs><input fillType="GARLIC" amount="12"/><input fillType="OLIVE_OIL" amount="2"/></inputs><outputs><output fillType="GARLIC_IN_OIL" amount="10"/></outputs></production>
            <production id="mushroomsInOil" name="$l10n_fillType_mushroomsInOil" cyclesPerHour="6" costsPerActiveHour="3"><inputs><input fillType="OYSTER" amount="8"/><input fillType="OLIVE_OIL" amount="2"/></inputs><outputs><output fillType="MUSHROOMS_IN_OIL" amount="10"/></outputs></production>
            <production id="herbDryer" name="Dried herbs" cyclesPerHour="6" costsPerActiveHour="2"><inputs><input fillType="BASIL" amount="5"/><input fillType="PARSLEY" amount="5"/><input fillType="ROSEMARY" amount="5"/><input fillType="SAGE" amount="5"/><input fillType="THYME" amount="5"/><input fillType="MINT" amount="5"/></inputs><outputs><output fillType="DRIED_BASIL" amount="4"/><output fillType="DRIED_PARSLEY" amount="4"/><output fillType="DRIED_ROSEMARY" amount="4"/><output fillType="DRIED_SAGE" amount="4"/><output fillType="DRIED_THYME" amount="4"/><output fillType="DRIED_MINT" amount="4"/></outputs></production>
            <production id="ricottaSpinachFilling" name="$l10n_fillType_ricottaSpinachFilling" cyclesPerHour="5" costsPerActiveHour="3"><inputs><input fillType="RICOTTA" amount="8"/><input fillType="SPINACH" amount="8"/></inputs><outputs><output fillType="RICOTTA_SPINACH_FILLING" amount="12"/></outputs></production>
            <production id="ravioli" name="$l10n_fillType_ravioli" cyclesPerHour="4" costsPerActiveHour="3"><inputs><input fillType="PASTA" amount="8"/><input fillType="RICOTTA_SPINACH_FILLING" amount="8"/></inputs><outputs><output fillType="RAVIOLI" amount="12"/></outputs></production>
            <production id="pastaAlPomodoro" name="$l10n_fillType_pastaAlPomodoro" cyclesPerHour="4" costsPerActiveHour="3"><inputs><input fillType="PASTA" amount="10"/><input fillType="SUGO_AL_POMODORO" amount="8"/></inputs><outputs><output fillType="PASTA_AL_POMODORO" amount="14"/></outputs></production>
            <production id="pastaArrabbiata" name="$l10n_fillType_pastaArrabbiata" cyclesPerHour="4" costsPerActiveHour="3"><inputs><input fillType="PASTA" amount="10"/><input fillType="ARRABBIATA" amount="8"/></inputs><outputs><output fillType="PASTA_ARRABBIATA" amount="14"/></outputs></production>
            <production id="pastaAiFunghi" name="$l10n_fillType_pastaAiFunghi" cyclesPerHour="4" costsPerActiveHour="3"><inputs><input fillType="PASTA" amount="10"/><input fillType="SUGO_AI_FUNGHI" amount="8"/></inputs><outputs><output fillType="PASTA_AI_FUNGHI" amount="14"/></outputs></production>
            <production id="pastaAlPesto" name="$l10n_fillType_pastaAlPesto" cyclesPerHour="4" costsPerActiveHour="3"><inputs><input fillType="PASTA" amount="10"/><input fillType="PESTO" amount="8"/></inputs><outputs><output fillType="PASTA_AL_PESTO" amount="14"/></outputs></production>
            <production id="gnocchiAlPomodoro" name="$l10n_fillType_gnocchiAlPomodoro" cyclesPerHour="4" costsPerActiveHour="3"><inputs><input fillType="GNOCCHI" amount="10"/><input fillType="SUGO_AL_POMODORO" amount="8"/></inputs><outputs><output fillType="GNOCCHI_AL_POMODORO" amount="14"/></outputs></production>
        </productions>

        <storage isExtension="false" fillLevelSyncThreshold="50">
            <capacity fillType="FLOUR"			capacity="60000" />
			<capacity fillType="POTATO"         capacity="60000" />
			<capacity fillType="TOMATO"        	capacity="20000" />
			<capacity fillType="SPINACH"      	capacity="20000" />
            <capacity fillType="EGG"          	capacity="10000" />
			<capacity fillType="PASTA"          capacity="25000" />
			<capacity fillType="PASTAUOVO"   	capacity="25000" />
			<capacity fillType="GNOCCHI" 		capacity="25000" />
            <capacity fillType="TRICOLORE"		capacity="25000" />
            <capacity fillType="PEPPER" capacity="20000"/><capacity fillType="BASIL" capacity="10000"/><capacity fillType="PARSLEY" capacity="10000"/><capacity fillType="ROSEMARY" capacity="10000"/><capacity fillType="SAGE" capacity="10000"/><capacity fillType="THYME" capacity="10000"/><capacity fillType="MINT" capacity="10000"/>
            <capacity fillType="PASSATA" capacity="25000"/><capacity fillType="SUGO_AL_POMODORO" capacity="25000"/><capacity fillType="ARRABBIATA" capacity="25000"/><capacity fillType="MARINARA" capacity="25000"/><capacity fillType="SUGO_AI_FUNGHI" capacity="25000"/><capacity fillType="PESTO" capacity="25000"/><capacity fillType="PESTO_ROSSO" capacity="25000"/><capacity fillType="RICOTTA" capacity="20000"/><capacity fillType="RICOTTA_SPINACH_FILLING" capacity="25000"/><capacity fillType="RAVIOLI" capacity="25000"/>
            <capacity fillType="EGGPLANT" capacity="20000"/><capacity fillType="ASPARAGUS_WHITE" capacity="20000"/><capacity fillType="ASPARAGUS_GREEN" capacity="20000"/><capacity fillType="CHIVES" capacity="10000"/><capacity fillType="LEMONBALM" capacity="10000"/><capacity fillType="DRIED_BASIL" capacity="25000"/><capacity fillType="DRIED_PARSLEY" capacity="25000"/><capacity fillType="DRIED_ROSEMARY" capacity="25000"/><capacity fillType="DRIED_SAGE" capacity="25000"/><capacity fillType="DRIED_THYME" capacity="25000"/><capacity fillType="DRIED_MINT" capacity="25000"/><capacity fillType="PRESERVED_PEPPERS" capacity="25000"/><capacity fillType="GARLIC_IN_OIL" capacity="25000"/><capacity fillType="MUSHROOMS_IN_OIL" capacity="25000"/><capacity fillType="PASTA_AL_POMODORO" capacity="25000"/><capacity fillType="PASTA_ARRABBIATA" capacity="25000"/><capacity fillType="PASTA_AI_FUNGHI" capacity="25000"/><capacity fillType="PASTA_AL_PESTO" capacity="25000"/><capacity fillType="GNOCCHI_AL_POMODORO" capacity="25000"/>
        </storage>

        <sellingStation node="sellingStation" supportsExtension="false">
            <unloadTrigger exactFillRootNode="exactFillNode" aiNode="unloadTriggerAINode" fillTypes="POTATO TOMATO SPINACH PEPPER EGGPLANT ASPARAGUS_WHITE ASPARAGUS_GREEN BASIL PARSLEY ROSEMARY SAGE CHIVES THYME LEMONBALM OYSTER OLIVE_OIL CHEESE RICOTTA PASTA GNOCCHI"/>
            <palletTrigger triggerNode="palletTrigger" aiNode="unloadTriggerAINode" fillTypes="FLOUR POTATO TOMATO SPINACH PEPPER EGGPLANT ASPARAGUS_WHITE ASPARAGUS_GREEN BASIL PARSLEY ROSEMARY SAGE CHIVES THYME LEMONBALM OYSTER OLIVE_OIL CHEESE RICOTTA PASTA GNOCCHI"/>
        </sellingStation>

        <palletSpawner>
            <spawnPlaces>
                <spawnPlace startNode="palletAreaStart01" endNode="palletAreaEnd01"/>
                <spawnPlace startNode="palletAreaStart02" endNode="palletAreaEnd02"/>
            </spawnPlaces>
        </palletSpawner>

        <playerTrigger node="playerTrigger" />
        <sounds>
            <idle   template="cerealFactoryIdle" linkNode="0>" outerRadius="50"/>
            <active template="cerealFactoryWork" linkNode="0>" outerRadius="50"/>
        </sounds>
    </productionPoint>

    <triggerMarkers>
        <triggerMarker node="warningStripes01"/>
        <triggerMarker node="playerTriggerMarker" adjustToGround="true" filename="$data/shared/assets/marker/markerIconWrench.i3d"/>
        <triggerMarker node="unloadTriggerMarker" adjustToGround="true" filename="$data/shared/assets/marker/markerIconUnload.i3d"/>
    </triggerMarkers>

    <hotspots>
        <hotspot type="PRODUCTION_POINT" linkNode="unloadTriggerMarker" teleportNode="unloadTriggerMarker" />
    </hotspots>

    <i3dMappings>
        <i3dMapping id="pastaFactory" node="0>" />
        <i3dMapping id="indoorAreaStart01" node="0>0|0" />
        <i3dMapping id="indoorAreaWidth01" node="0>0|0|0" />
        <i3dMapping id="indoorAreaHeight01" node="0>0|0|1" />
        <i3dMapping id="indoorAreaStart02" node="0>0|1" />
        <i3dMapping id="indoorAreaWidth02" node="0>0|1|0" />
        <i3dMapping id="indoorAreaHeight02" node="0>0|1|1" />
        <i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>1|0" />
        <i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>1|0|0" />
        <i3dMapping id="infoTrigger" node="0>2" />
        <i3dMapping id="sellingStation" node="0>3" />
        <i3dMapping id="exactFillNode" node="0>3|0" />
        <i3dMapping id="unloadTriggerMarker" node="0>3|0|0" />
        <i3dMapping id="unloadTriggerAINode" node="0>3|0|1" />
        <i3dMapping id="palletTrigger" node="0>3|2" />
        <i3dMapping id="playerTrigger" node="0>4|0" />
        <i3dMapping id="playerTriggerMarker" node="0>4|0|0" />
        <i3dMapping id="palletSpawner" node="0>5" />
        <i3dMapping id="palletAreaStart01" node="0>5|0|1" />
        <i3dMapping id="palletAreaEnd01" node="0>5|0|1|0" />
        <i3dMapping id="palletAreaStart02" node="0>5|0|2" />
        <i3dMapping id="palletAreaEnd02" node="0>5|0|2|0" />
        <i3dMapping id="warningStripes01" node="0>5|0|0" />
        <i3dMapping id="smoke01" node="0>6|0" />
		<i3dMapping id="testArea1Start" node="0>9" />
		<i3dMapping id="testArea1End" node="0>9|0" />
		<i3dMapping id="clearAreaStart01" node="0>10|0" />
        <i3dMapping id="clearAreaWidth01" node="0>10|0|0" />
        <i3dMapping id="clearAreaHeight01" node="0>10|0|1" />
		<i3dMapping id="levelAreaStart01" node="0>11|0" />
		<i3dMapping id="levelAreaWidth01" node="0>11|0|0" />
        <i3dMapping id="levelAreaHeight01" node="0>11|0|1" />
    </i3dMappings>
</placeable>
