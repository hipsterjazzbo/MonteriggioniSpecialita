                <section segmentId="GATE4m">
                    <node node="gateStart" />
                    <node node="gateEnd" />
                </section>
                <section segmentId="SEGMENT" customizable="true">
                    <node node="gateEnd" />
                    <node node="fence1Node02" />
                    <node node="fence1Node03" />
                    <node node="fence1Node04" />
                </section>
            </sections>
        </fence>

        <meadow>
            <createTask weedState="0">
                <decoFoliage name="grassShort" />
                <ground type="NONE" />
                <terrainGroundType name="grass" />
            </createTask>
        </meadow>
