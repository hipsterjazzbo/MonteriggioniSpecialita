            <baleTrigger triggerNode="baleTriggerStraw" fillTypes="STRAW"/>
            <unloadTrigger fillTypes="MANURE" />
        </unloadingStation>

        <loadingStation supportsExtension="true" storageRadius="50" fillTypes="STRAW" />

        <animals type="HORSE" maxNumAnimals="10">
            <navigation rootNode="navigationRootNode" />
            <loadingTrigger node="loadingTrigger" />

            <deliveryAreas>
                <deliveryArea startNode="deliveryAreaStart01" widthNode="deliveryAreaWidth01" heightNode="deliveryAreaHeight01"/>
            </deliveryAreas>
        </animals>

        <food capacity="20000" >
            <foodPlane node="foodPlane" minRotX="90" maxRotX="0" changeVisibility="true" defaultFillType="OAT" />
            <unloadTrigger exactFillRootNode="exactFillRootNodeFood" />
            <baleTrigger triggerNode="baleTriggerFood"/>
            <palletTrigger triggerNode="palletTrigger"/>
        </food>

        <water automaticWaterSupply="true" />

        <straw>
            <manure factor="1.5" />
            <strawPlane node="strawPlane" changeVisibility="true" minY="-0.5" maxY="0.0" />	<!-- minY="-0.15" maxY="0.0" -->
        </straw>

