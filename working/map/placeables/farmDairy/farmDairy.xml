<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="productionPoint" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_storeItem_farmDairy</name>
        <functions>
            <function>$l10n_function_productionPoint</function>
        </functions>
        <image>map/placeables/farmDairy/store_farmDairy.dds</image>
        <price>36000</price>
		<dailyUpkeep>25</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>productionPoints</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>factories</tab>
        </brush>
		<canBeSold>true</canBeSold>
        <showInStore>false</showInStore>
    </storeData>

    <base>
        <filename>map/placeables/farmDairy/farmDairy.i3d</filename>
        <canBeRenamed>true</canBeRenamed>
        <boughtWithFarmland>true</boughtWithFarmland>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01" />
        </testAreas>
        <sounds>
            <place template="smallImp"/>
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30" >
        <levelAreas>
            <levelArea startNode="levelAreaStart01" widthNode="levelAreaWidth01" heightNode="levelAreaHeight01" groundType="asphalt"/>
        </levelAreas>
        <paintAreas>
            <paintArea startNode="paintAreaStart01" widthNode="paintAreaWidth01" heightNode="paintAreaHeight01" groundType="asphalt"/>
        </paintAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01" />
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
        </updateAreas>
    </ai>

    <infoTrigger triggerNode="infoTrigger"/>

    <hotspots>
        <hotspot type="PRODUCTION_POINT" linkNode="unloadTriggerMarker" teleportNode="playerTriggerMarker" />
    </hotspots>

    <dynamicallyLoadedParts>
        <dynamicallyLoadedPart node="0" linkNode="lightSwitch01" filename="$data/shared/assets/lights/rudolfHormann/powerSwitch.i3d" />
    </dynamicallyLoadedParts>

	<animatedObjects>
		<animatedObject saveId="rollingDoor1" >
            <animation duration="5">
                <part node="rollingDoor1ColBottom">
                    <keyFrame time="0.0" translation="0 0 0"/>
                    <keyFrame time="1.0" translation="0 3.8 0"/>
                </part>
                <part node="rollingDoor1ColTop">
                    <keyFrame time="0.0" translation="0 0 0"/>
                    <keyFrame time="0.55" translation="0 0 0"/>
                    <keyFrame time="1.0" translation="0 1.7 0"/>
                </part>
                <part node="rollingDoor1">
                    <keyFrame time="0.0" translation="0 0 0" />
                    <keyFrame time="1.0" translation="0 3.85 0" />
                </part>
                <shader node="rollingDoor1" parameterName="visibilityCutThreshold">
                    <keyFrame time="0.0" values="0 - - -" />
                    <keyFrame time="1.0" values="0.94 - - -" />
                </shader>
            </animation>
            <controls triggerNode="rollingDoor1Trigger" posAction="ACTIVATE_HANDTOOL" posText="action_openGate" negText="action_closeGate" />
            <sounds>
                <moving linkNode="rollingDoor1Base" template="rollingGarageDoor" />
                <posEnd linkNode="rollingDoor1Base" template="slidingGateMetalOpen" />
                <negEnd linkNode="rollingDoor1Base" template="slidingGateMetalClose" />
            </sounds>
        </animatedObject>
	</animatedObjects>

    <triggerMarkers>
        <triggerMarker node="warningStripes01"/>
        <triggerMarker node="warningStripes02"/>
        <triggerMarker node="unloadTriggerMarker" adjustToGround="true" filename="$data/shared/assets/marker/markerIconUnload.i3d"/>
        <triggerMarker node="playerTriggerMarker" adjustToGround="true" filename="$data/shared/assets/marker/markerIconWrench.i3d"/>
    </triggerMarkers>

    <!--<lights>
        <sharedLight filename="$data/shared/assets/lights/terraLed/fluorescentTube50W.xml" linkNode="lightNode01" groupIndex="1"/>

        <realLights>
            <low>
                <light node="realLightsLow" groupIndex="1"/>
            </low>
            <high>
                <light node="realLightsHigh" groupIndex="1"/>
            </high>
        </realLights>

        <group name="$l10n_action_placeableLightShed" triggerNode="lightTrigger01">
            <sounds>
                <toggle template="lizardFloodLight" innerRadius="3" outerRadius="15" volumeScale="0.2"/>
            </sounds>
        </group>
    </lights>-->
	
	<lights>
        <sharedLight filename="$data/shared/assets/lights/terraLed/fluorescentTube50W.xml" linkNode="fluorescentTube50W_01" groupIndex="1" />
        <sharedLight filename="$data/shared/assets/lights/terraLed/fluorescentTube50W.xml" linkNode="fluorescentTube50W_02" groupIndex="1" />
		<sharedLight filename="$data/shared/assets/lights/terraLed/fluorescentTube50W.xml" linkNode="fluorescentTube50W_03" groupIndex="1" />
        <sharedLight filename="$data/shared/assets/lights/terraLed/fluorescentTube50W.xml" linkNode="fluorescentTube50W_04" groupIndex="1" />

        <realLights>
            <low>
                <light node="realLightsLow" groupIndex="1"/>
            </low>
            <high>
                <light node="realLightsHigh" groupIndex="1"/>
            </high>
        </realLights>

        <!--<group name="$l10n_action_placeableLightShed" activateTime="17:30" deactivateTime="8:20"/>-->
		<group name="$l10n_action_placeableLightShed" triggerNode="lightTrigger">
            <sounds>
                <toggle template="lizardFloodLight" innerRadius="3" outerRadius="15" volumeScale="0.2"/>
            </sounds>
        </group>
    </lights>

    <productionPoint>
        <productions>
            <production id="butter_milk" name="%s (%s)" params="$l10n_fillType_butter|$l10n_fillType_milk" cyclesPerHour="10" costsPerActiveHour="1">
                <inputs>
                    <input fillType="MILK" amount="15" />
                </inputs>
                <outputs>
                    <output fillType="BUTTER" amount="13" />
                </outputs>
            </production>
            <production id="butter_goatMilk" name="%s (%s)" params="$l10n_fillType_butter|$l10n_fillType_goatMilk" cyclesPerHour="15" costsPerActiveHour="4">
                <inputs>
                    <input fillType="GOATMILK" amount="3" />
                </inputs>
                <outputs>
                    <output fillType="BUTTER" amount="10" />
                </outputs>
            </production>
            <production id="butter_buffaloMilk" name="%s (%s)" params="$l10n_fillType_butter|$l10n_fillType_buffaloMilk" cyclesPerHour="1" costsPerActiveHour="8">
                <inputs>
                    <input fillType="BUFFALOMILK" amount="3" />
                </inputs>
                <outputs>
                    <output fillType="BUTTER" amount="45" />
                </outputs>
            </production>

            <production id="cheese" name="$l10n_fillType_cheese" cyclesPerHour="25" costsPerActiveHour="1">
                <inputs>
                    <input fillType="MILK" amount="3" />
                </inputs>
                <outputs>
                    <output fillType="CHEESE" amount="2" />
                </outputs>
            </production>
            <production id="goatcheese" name="$l10n_fillType_goatCheese" cyclesPerHour="20" costsPerActiveHour="4">
                <inputs>
                    <input fillType="GOATMILK" amount="3" />
                </inputs>
                <outputs>
                    <output fillType="GOATCHEESE" amount="6" />
                </outputs>
            </production>
            <production id="buffalomozzarella" name="$l10n_fillType_buffaloMozzarella" cyclesPerHour="10" costsPerActiveHour="8">
                <inputs>
                    <input fillType="BUFFALOMILK" amount="3" />
                </inputs>
                <outputs>
                    <output fillType="BUFFALOMOZZARELLA" amount="2" />
                </outputs>
            </production>

            <production id="cream_milk" name="$l10n_fillType_cream" cyclesPerHour="20" costsPerActiveHour="1"><inputs><input fillType="MILK" amount="10"/></inputs><outputs><output fillType="CREAM" amount="6"/></outputs></production>
            <production id="ricotta_milk" name="$l10n_fillType_ricotta" cyclesPerHour="15" costsPerActiveHour="1"><inputs><input fillType="MILK" amount="12"/></inputs><outputs><output fillType="RICOTTA" amount="8"/></outputs></production>
            <production id="cream_goatMilk" name="$l10n_fillType_goatCream" cyclesPerHour="15" costsPerActiveHour="4"><inputs><input fillType="GOATMILK" amount="10"/></inputs><outputs><output fillType="GOAT_CREAM" amount="6"/></outputs></production>
            <production id="caprino_goatMilk" name="$l10n_fillType_caprino" cyclesPerHour="15" costsPerActiveHour="4"><inputs><input fillType="GOATMILK" amount="10"/></inputs><outputs><output fillType="CAPRINO" amount="6"/></outputs></production>
            <production id="ricotta_goatMilk" name="$l10n_fillType_goatRicotta" cyclesPerHour="15" costsPerActiveHour="4"><inputs><input fillType="GOATMILK" amount="12"/></inputs><outputs><output fillType="GOAT_RICOTTA" amount="8"/></outputs></production>
            <production id="ricotta_buffaloMilk" name="$l10n_fillType_buffaloRicotta" cyclesPerHour="10" costsPerActiveHour="8"><inputs><input fillType="BUFFALOMILK" amount="12"/></inputs><outputs><output fillType="BUFFALO_RICOTTA" amount="8"/></outputs></production>

            <production id="chocolate" name="$l10n_fillType_chocolate" cyclesPerHour="50" costsPerActiveHour="1">
                <inputs>
                    <input fillType="MILK"  amount="1" />
                    <input fillType="SUGAR" amount="1" />
                </inputs>
                <outputs>
                    <output fillType="CHOCOLATE" amount="1" />
                </outputs>
            </production>

            <production id="milkBottled" name="$l10n_fillType_milk_bottled" cyclesPerHour="10" costsPerActiveHour="1">
                <inputs>
                    <input fillType="MILK" amount="10" />
                </inputs>
                <outputs>
                    <output fillType="MILK_BOTTLED" amount="20" />
                </outputs>
            </production>
            <production id="goatmilkBottled" name="$l10n_fillType_goatMilk_bottled" cyclesPerHour="3" costsPerActiveHour="4">
                <inputs>
                    <input fillType="GOATMILK" amount="10" />
                </inputs>
                <outputs>
                    <output fillType="GOATMILK_BOTTLED" amount="20" />
                </outputs>
            </production>
            <production id="buffalomilkBottled" name="$l10n_fillType_buffaloMilk_bottled" cyclesPerHour="3" costsPerActiveHour="8">
                <inputs>
                    <input fillType="BUFFALOMILK" amount="10" />
                </inputs>
                <outputs>
                    <output fillType="BUFFALOMILK_BOTTLED" amount="20" />
                </outputs>
            </production>
        </productions>

        <storage isExtension="false" fillLevelSyncThreshold="50">
            <capacity fillType="MILK"                capacity="10000" />
            <capacity fillType="GOATMILK"            capacity="4000" />
            <capacity fillType="BUFFALOMILK"         capacity="5000" />
            <capacity fillType="SUGAR"               capacity="3000" />
            <capacity fillType="BUTTER"              capacity="7000" />
            <capacity fillType="CHEESE"              capacity="7000" />
            <capacity fillType="GOATCHEESE"          capacity="5000" />
            <capacity fillType="BUFFALOMOZZARELLA"   capacity="5000" />
            <capacity fillType="CREAM"                capacity="7000" />
            <capacity fillType="RICOTTA"              capacity="7000" />
            <capacity fillType="GOAT_CREAM"           capacity="5000" />
            <capacity fillType="CAPRINO"              capacity="5000" />
            <capacity fillType="GOAT_RICOTTA"         capacity="5000" />
            <capacity fillType="BUFFALO_RICOTTA"      capacity="5000" />
            <capacity fillType="CHOCOLATE"           capacity="3000" />
            <capacity fillType="MILK_BOTTLED"        capacity="9600" />
            <capacity fillType="GOATMILK_BOTTLED"    capacity="5000" />
            <capacity fillType="BUFFALOMILK_BOTTLED" capacity="5000" />
        </storage>

        <sellingStation node="sellingStation" supportsExtension="false" allowMissions="false">
            <unloadTrigger exactFillRootNode="exactFillNode" aiNode="unloadTriggerAINode" fillTypes="MILK GOATMILK BUFFALOMILK"/>
            <palletTrigger triggerNode="palletTrigger" fillTypes="MILK GOATMILK BUFFALOMILK SUGAR"/>
        </sellingStation>

        <palletSpawner>
            <spawnPlaces>
                <spawnPlace startNode="palletAreaStart01" endNode="palletAreaEnd01"/>
            </spawnPlaces>
        </palletSpawner>

        <playerTrigger node="playerTrigger" />
        <sounds>
            <idle   template="placeableSmallIdleGeneric" linkNode="0>"/>
            <active template="dairyWork" linkNode="0>" pitchScale="1.2" innerRadius="2" outerRadius="15" volumeScale="0.9"/>
        </sounds>
    </productionPoint>

    <i3dMappings>
        <i3dMapping id="clearAreaStart01" node="0>0|0" />
        <i3dMapping id="clearAreaWidth01" node="0>0|0|0" />
        <i3dMapping id="clearAreaHeight01" node="0>0|0|1" />
        <i3dMapping id="levelAreaStart01" node="0>1|0" />
        <i3dMapping id="levelAreaWidth01" node="0>1|0|0" />
        <i3dMapping id="levelAreaHeight01" node="0>1|0|1" />
