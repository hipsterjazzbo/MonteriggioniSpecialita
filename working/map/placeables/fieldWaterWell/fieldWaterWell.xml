<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="buyingStation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_hotspot_waterwell</name>
        <image>map/placeables/fieldWaterWell/store_fieldWaterWell.png</image>
        <functions>
            <function>$l10n_function_waterWell</function>
        </functions>
        <price>0</price>
        <dailyUpkeep>0</dailyUpkeep>
        <canBeSold>false</canBeSold>
        <showInStore>false</showInStore>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
		<canBeSold>false</canBeSold>
        <showInStore>false</showInStore>
        <species>PLACEABLE</species>
    </storeData>

    <base>
        <filename>map/placeables/fieldWaterWell/fieldWaterWell.i3d</filename>
		<canBeRenamed>false</canBeRenamed>
		<boughtWithFarmland>false</boughtWithFarmland>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true"/>

    <clearAreas/>

    <leveling/>

    <indoorAreas/>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
        </updateAreas>
    </ai>

    <triggerMarkers>
        <triggerMarker node="loadingMarker" filename="$data/shared/assets/marker/markerIconWater.i3d" adjustToGround="true"/>
    </triggerMarkers>

    <buyingStation node="fillTrigger" supportsExtension="false" >
        <loadTrigger triggerNode="fillTrigger" aiNode="aiNode" fillTypes="WATER" fillLitersPerSecond="400" autoStart="true" />
        <fillType name="water" priceScale="1" statsName="purchaseWater" />
    </buyingStation>
	
	<hotspots>
        <hotspot type="LOADING" linkNode="fillTrigger" teleportNode="teleportNode" />
    </hotspots>

    <i3dMappings>
        <i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>0|0" />
        <i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>0|0|0" />
        <i3dMapping id="fillTrigger" node="0>1|0" />
        <i3dMapping id="loadingMarker" node="0>1|1" />
		<i3dMapping id="teleportNode" node="0>1|2" />
		<i3dMapping id="aiNode" node="0>1|3" />
    </i3dMappings>
</placeable>
