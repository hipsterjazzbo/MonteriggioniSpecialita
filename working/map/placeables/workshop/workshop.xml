<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="workshop" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_shopItem_workshop</name>
        <image>map/placeables/workshop/store_workshop.dds</image>
        <price>1000</price>
        <functions>
            <function>$l10n_function_workshop</function>
        </functions>
		<canBeSold>false</canBeSold>
        <showInStore>false</showInStore>
        <dailyUpkeep>10</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>placeableMisc</category>
        <brush>
            <type>placeable</type>
            <category>buildings</category>
            <tab>tools</tab>
        </brush>
    </storeData>

    <base>
        <filename>map/placeables/workshop/workshop.i3d</filename>
        <canBeRenamed>false</canBeRenamed>
        <boughtWithFarmland>true</boughtWithFarmland>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
        </testAreas>

        <sounds>
            <place template="smallImp"/>
        </sounds>
    </placement>

    <clearAreas>
    </clearAreas>

    <leveling requireLeveling="false" maxSmoothDistance="3" maxSlope="75" maxEdgeAngle="30">
        <levelAreas>
        </levelAreas>
    </leveling>

    <indoorAreas>
    </indoorAreas>

    <tipOcclusionUpdateAreas>
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
        </updateAreas>
    </ai>

    <triggerMarkers>
        <triggerMarker node="markerWrench" filename="$data/shared/assets/marker/markerIconWrench.i3d" />
        <triggerMarker node="warningStripes"/>
    </triggerMarkers>

    <hotspots>
        <hotspot type="SHOP" linkNode="vehicleTrigger" teleportNode="playerTrigger"/>
    </hotspots>

    <workshop>
        <sellingPoint playerTriggerNode="playerTrigger" iconNode="markerWrench" sellTriggerNode="vehicleTrigger" ownWorkshop="true" mobileWorkshop="false" />
    </workshop>

    <i3dMappings>
        <i3dMapping id="markerWrench" node="0>0|0" />
        <i3dMapping id="warningStripes" node="0>0|1" />
        <i3dMapping id="vehicleTrigger" node="0>0|2" />
        <i3dMapping id="playerTrigger" node="0>0|3" />
