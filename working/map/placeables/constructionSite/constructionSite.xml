<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="simplePlaceable" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_storeItem_constructionSite</name>
        <functions>
            <function>$l10n_function_removeDecoration</function>
        </functions>
        <image>map/placeables/constructionSite/store_constructionSite.png</image>
        <price>10000</price>
		<canBeSold>true</canBeSold>
        <showInStore>false</showInStore>
        <dailyUpkeep>0</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>decoration</category>
    </storeData>

    <base>
        <filename>map/placeables/constructionSite/constructionSite.i3d</filename>
		<boughtWithFarmland>true</boughtWithFarmland>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true">
        <sounds>
            <place template="smallImp" />
        </sounds>
    </placement>

    <clearAreas>
    </clearAreas>

    <leveling requireLeveling="false" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30">
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01" />
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
    </tipOcclusionUpdateAreas>

    <ai>
      <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
        </updateAreas>  
    </ai>

    <i3dMappings>
        <i3dMapping id="indoorAreaStart01" node="1>0" />
        <i3dMapping id="indoorAreaWidth01" node="1>0|0" />
        <i3dMapping id="indoorAreaHeight01" node="1>0|1" />
		<i3dMapping id="tipOcclusionUpdateAreaStart01" node="2>0" />
        <i3dMapping id="tipOcclusionUpdateAreaEnd01" node="2>0|0" />
    </i3dMappings>
</placeable>
