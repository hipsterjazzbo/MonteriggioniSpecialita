<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="sellingStation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_sellStation_wareHouseSilos</name>
        <functions>
            <function>$l10n_function_sellingPoint</function>
        </functions>
        <image>map/placeables/warehouseSilos/store_warehouseSilos.png</image>
        <price>1245000</price>
		<dailyUpkeep>1500</dailyUpkeep>
		<canBeSold>false</canBeSold>
        <showInStore>false</showInStore>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>sellingPoints</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>sellingPoints</tab>
        </brush>
    </storeData>

    <base>
        <filename>map/placeables/warehouseSilos/warehouseSilos.i3d</filename>
		<canBeDeleted>false</canBeDeleted>
		<canBeRenamed>false</canBeRenamed>
		<boughtWithFarmland>false</boughtWithFarmland>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01" />
            <testArea startNode="testAreaStart02" endNode="testAreaEnd02" />
        </testAreas>

        <sounds>
            <place template="siloImp" />
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
        <clearArea startNode="clearAreaStart02" widthNode="clearAreaWidth02" heightNode="clearAreaHeight02"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="3" maxSlope="75" maxEdgeAngle="30">
        <levelAreas>
            <levelArea startNode="levelAreaStart01" widthNode="levelAreaWidth01" heightNode="levelAreaHeight01" groundType="asphalt"/>
            <levelArea startNode="levelAreaStart02" widthNode="levelAreaWidth02" heightNode="levelAreaHeight02" groundType="asphalt"/>
        </levelAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01"/>
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
        </updateAreas>
        <splines>
            <spline node="aiLoadingSpline"   maxWidth="4.2"/>
            <spline node="aiUnloadingSpline" maxWidth="4.2"/>
        </splines>
    </ai>

    <infoTrigger triggerNode="infoTrigger"/>

    <lights>
        <sharedLight filename="$data/shared/assets/lights/terraLed/light150W.xml" linkNode="lightNode01" groupIndex="1"/>
        <sharedLight filename="$data/shared/assets/lights/terraLed/light150W.xml" linkNode="lightNode02" groupIndex="1"/>
        <sharedLight filename="$data/shared/assets/lights/terraLed/light150W.xml" linkNode="lightNode03" groupIndex="1"/>
        <sharedLight filename="$data/shared/assets/lights/terraLed/light150W.xml" linkNode="lightNode04" groupIndex="1"/>

        <realLights>
            <low>
                <light node="realLightsLow" groupIndex="1"/>
            </low>
            <high>
                <light node="realLightsHigh" groupIndex="1"/>
            </high>
        </realLights>

        <group name="$l10n_action_placeableLightShed" activateTime="17:30" deactivateTime="8:20"/>
    </lights>

    <hotspots>
        <hotspot type="UNLOADING" linkNode="mapPosition" teleportNode="markerLoading"/>
    </hotspots>

    <triggerMarkers>
        <triggerMarker node="markerLoading"   filename="$data/shared/assets/marker/markerIconLoad.i3d" />
        <triggerMarker node="markerUnloading" filename="$data/shared/assets/marker/markerIconUnload.i3d" />
    </triggerMarkers>
	
	<sellingStation appearsOnStats="true" litersForFullPriceDrop="500000" fullPriceRecoverHours="48" supportsExtension="false">
        
		<unloadTrigger exactFillRootNode="exactFillRootNode" aiNode="aiUnloadingNode" fillTypeCategories="SELLINGSTATION_FIELDFRUITS" priceScale="1" fillTypesExclude="FORAGE HAY GRASS SILAGE WOODCHIPS SUGARBEET_CUT" fillTypes="SEEDS"/>
        <palletTrigger triggerNode="palletTrigger" fillTypes="OLIVE"/>
		
        <fillType name="SEEDS" priceScale="1.0"/>

        <sounds>
            <idle template="siloImp" volumeScale="3"/>
        </sounds>
    </sellingStation>

    <i3dMappings>
        <i3dMapping id="clearAreaStart01" node="0>0|0" />
        <i3dMapping id="clearAreaWidth01" node="0>0|0|0" />
        <i3dMapping id="clearAreaHeight01" node="0>0|0|1" />
        <i3dMapping id="clearAreaStart02" node="0>0|1" />
        <i3dMapping id="clearAreaWidth02" node="0>0|1|0" />
        <i3dMapping id="clearAreaHeight02" node="0>0|1|1" />
        <i3dMapping id="levelAreaStart01" node="0>1|0" />
        <i3dMapping id="levelAreaWidth01" node="0>1|0|0" />
        <i3dMapping id="levelAreaHeight01" node="0>1|0|1" />
        <i3dMapping id="levelAreaStart02" node="0>1|1" />
        <i3dMapping id="levelAreaWidth02" node="0>1|1|0" />
        <i3dMapping id="levelAreaHeight02" node="0>1|1|1" />
        <i3dMapping id="testAreaStart01" node="0>2|0" />
        <i3dMapping id="testAreaEnd01" node="0>2|0|0" />
        <i3dMapping id="testAreaStart02" node="0>2|1" />
        <i3dMapping id="testAreaEnd02" node="0>2|1|0" />
        <i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>3|0" />
        <i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>3|0|0" />
        <i3dMapping id="realLightsLow" node="0>4|0|0" />
        <i3dMapping id="realLightsHigh" node="0>4|0|1" />
        <i3dMapping id="lightNode01" node="0>4|1|0" />
        <i3dMapping id="lightNode02" node="0>4|1|1" />
        <i3dMapping id="lightNode03" node="0>4|1|2" />
        <i3dMapping id="lightNode04" node="0>4|1|3" />
        <i3dMapping id="mapPosition" node="0>5|0" />
        <i3dMapping id="storage" node="0>5|1" />
        <i3dMapping id="loadingTrigger" node="0>5|2|0|0" />
        <i3dMapping id="dischargeNode" node="0>5|2|0|1" />
        <i3dMapping id="pipeEffect" node="0>5|2|0|2|0" />
        <i3dMapping id="pipeEffectSmoke" node="0>5|2|0|2|1" />
        <i3dMapping id="aiLoadingNode" node="0>5|2|0|3" />
        <i3dMapping id="aiLoadingSpline" node="0>5|2|1" />
        <i3dMapping id="exactFillRootNode" node="0>5|3|0" />
        <i3dMapping id="aiUnloadingNode" node="0>5|3|1" />
        <i3dMapping id="aiUnloadingSpline" node="0>5|3|2" />
        <i3dMapping id="infoTrigger" node="0>5|4" />
        <i3dMapping id="palletTrigger" node="0>5|5" />
        <i3dMapping id="markerLoading" node="0>6|0" />
        <i3dMapping id="markerUnloading" node="0>6|1" />
		<i3dMapping id="indoorAreaStart01" node="0>10|0" />
        <i3dMapping id="indoorAreaWidth01" node="0>10|0|0" />
        <i3dMapping id="indoorAreaHeight01" node="0>10|0|1" />
    </i3dMappings>
</placeable>
