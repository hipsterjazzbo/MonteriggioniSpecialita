<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="productionPoint" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_storeItem_herbDryer</name>
        <functions>
            <function>$l10n_function_productionPoint</function>
        </functions>
        <image>map/placeables/smallOilPress/store_smallOilPress.dds</image>
        <price>12000</price>
		<dailyUpkeep>10</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>productionPoints</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>factories</tab>
        </brush>
		<canBeSold>true</canBeSold>
		<showInStore>true</showInStore>
    </storeData>

    <base>
        <filename>map/placeables/smallOilPress/smallOilPress.i3d</filename>
        <boughtWithFarmland>true</boughtWithFarmland>
        <canBeRenamed>true</canBeRenamed>
        <canBeSold>true</canBeSold>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01" />
        </testAreas>
        <sounds>
            <place template="smallImp"/>
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30" >
        <levelAreas>
            <levelArea startNode="levelAreaStart01" widthNode="levelAreaWidth01" heightNode="levelAreaHeight01" groundType="asphalt"/>
        </levelAreas>
        <paintAreas>
            <paintArea startNode="paintAreaStart01" widthNode="paintAreaWidth01" heightNode="paintAreaHeight01" groundType="asphalt"/>
        </paintAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01" />
		<indoorArea startNode="indoorAreaStart02" widthNode="indoorAreaWidth02" heightNode="indoorAreaHeight02" />
		<indoorArea startNode="indoorAreaStart03" widthNode="indoorAreaWidth03" heightNode="indoorAreaHeight03" />
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
        </updateAreas>
    </ai>

    <infoTrigger triggerNode="infoTrigger"/>

    <hotspots>
        <hotspot type="PRODUCTION_POINT" linkNode="unloadTriggerMarker" teleportNode="playerTriggerMarker" />
    </hotspots>

    <triggerMarkers>
        <triggerMarker node="warningStripes01"/>
        <triggerMarker node="warningStripes02"/>
        <triggerMarker node="unloadTriggerMarker" adjustToGround="true" filename="$data/shared/assets/marker/markerIconUnload.i3d"/>
        <triggerMarker node="playerTriggerMarker" adjustToGround="true" filename="$data/shared/assets/marker/markerIconWrench.i3d"/>
    </triggerMarkers>

    <productionPoint>
        <productions>
            <production id="specialita_herbs" name="Dried herbs" cyclesPerHour="4" costsPerActiveHour="0.5"><inputs><input fillType="BASIL" amount="5"/><input fillType="PARSLEY" amount="5"/><input fillType="ROSEMARY" amount="5"/><input fillType="SAGE" amount="5"/><input fillType="THYME" amount="5"/><input fillType="LEMONBALM" amount="5"/></inputs><outputs><output fillType="DRIED_BASIL" amount="4"/><output fillType="DRIED_PARSLEY" amount="4"/><output fillType="DRIED_ROSEMARY" amount="4"/><output fillType="DRIED_SAGE" amount="4"/><output fillType="DRIED_THYME" amount="4"/><output fillType="DRIED_MINT" amount="4"/></outputs></production>
        </productions>

        <storage isExtension="false" fillLevelSyncThreshold="50">
            <capacity fillType="SUNFLOWER"     capacity="9600" />
            <capacity fillType="CANOLA"        capacity="9600" />
            <capacity fillType="OLIVE"         capacity="9600" />
            <capacity fillType="RICELONGGRAIN" capacity="6000" />
            <capacity fillType="RICE"          capacity="6000" />
			<capacity fillType="GRAPESEED"     capacity="5000" />
            <capacity fillType="SESAME" capacity="5000" />
            <capacity fillType="SESAME_OIL" capacity="5000" />
			<capacity fillType="LAVENDER" capacity="5000" /><capacity fillType="MINT" capacity="5000" />
			<capacity fillType="LAVENDER_OIL" capacity="5000" /><capacity fillType="MINT_OIL" capacity="5000" />
            <capacity fillType="SUNFLOWER_OIL" capacity="5000" />
            <capacity fillType="CANOLA_OIL"    capacity="5000" />
            <capacity fillType="OLIVE_OIL"     capacity="5000" />
            <capacity fillType="RICE_OIL"      capacity="5000" />
            <capacity fillType="GRAPESEED_OIL" capacity="5000" />
        </storage>

        <sellingStation node="sellingStation" supportsExtension="false" allowMissions="false">
            <unloadTrigger exactFillRootNode="exactFillNode" aiNode="unloadTriggerAINode" fillTypes="SUNFLOWER CANOLA OLIVE RICELONGGRAIN RICE GRAPESEED SESAME LAVENDER MINT"/>
			<palletTrigger triggerNode="palletTrigger" fillTypes="SUNFLOWER CANOLA OLIVE RICELONGGRAIN RICE GRAPESEED SESAME_OIL LAVENDER_OIL MINT_OIL"/>
		</sellingStation>

        <palletSpawner>
            <spawnPlaces>
                <spawnPlace startNode="palletAreaStart01" endNode="palletAreaEnd01"/>
            </spawnPlaces>
        </palletSpawner>

        <playerTrigger node="playerTrigger" />
        <sounds>
            <idle   template="placeableSmallIdleGeneric" linkNode="0>"/>
            <active template="dairyWork" linkNode="0>" pitchScale="1.2" innerRadius="2" outerRadius="15" volumeScale="0.9"/>
        </sounds>
    </productionPoint>

    <i3dMappings>
        <i3dMapping id="clearAreaStart01" node="0>0|0" />
        <i3dMapping id="clearAreaWidth01" node="0>0|0|0" />
        <i3dMapping id="clearAreaHeight01" node="0>0|0|1" />
        <i3dMapping id="levelAreaStart01" node="0>1|0" />
        <i3dMapping id="levelAreaWidth01" node="0>1|0|0" />
        <i3dMapping id="levelAreaHeight01" node="0>1|0|1" />
        <i3dMapping id="paintAreaStart01" node="0>2|0" />
        <i3dMapping id="paintAreaWidth01" node="0>2|0|0" />
        <i3dMapping id="paintAreaHeight01" node="0>2|0|1" />
        <i3dMapping id="indoorAreaStart01" node="0>3|0" />
        <i3dMapping id="indoorAreaWidth01" node="0>3|0|0" />
        <i3dMapping id="indoorAreaHeight01" node="0>3|0|1" />
		<i3dMapping id="indoorAreaStart02" node="0>3|1" />
        <i3dMapping id="indoorAreaWidth02" node="0>3|1|0" />
        <i3dMapping id="indoorAreaHeight02" node="0>3|1|1" />
		<i3dMapping id="indoorAreaStart03" node="0>3|2" />
        <i3dMapping id="indoorAreaWidth03" node="0>3|2|0" />
        <i3dMapping id="indoorAreaHeight03" node="0>3|2|1" />
        <i3dMapping id="testAreaStart01" node="0>4|0" />
        <i3dMapping id="testAreaEnd01" node="0>4|0|0" />
        <i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>5|0" />
        <i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>5|0|0" />
        <i3dMapping id="infoTrigger" node="0>6" />
        <i3dMapping id="sellingStation" node="0>7" />
        <i3dMapping id="exactFillNode" node="0>7|0" />
        <i3dMapping id="unloadTriggerMarker" node="0>7|1" />
        <i3dMapping id="unloadTriggerAINode" node="0>7|2" />
        <i3dMapping id="palletTrigger" node="0>7|3" />
        <i3dMapping id="playerTrigger" node="0>8|0" />
        <i3dMapping id="playerTriggerMarker" node="0>8|1" />
        <i3dMapping id="warningStripes01" node="0>9|0" />
        <i3dMapping id="warningStripes02" node="0>9|1" />
        <i3dMapping id="palletSpawner" node="0>10" />
        <i3dMapping id="palletAreaStart01" node="0>10|0" />
        <i3dMapping id="palletAreaEnd01" node="0>10|0|0" />
    </i3dMappings>
</placeable>
