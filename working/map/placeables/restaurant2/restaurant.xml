<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="sellingStation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_sellStation_restaurant2</name>
        <functions>
            <function>$l10n_function_sellingPoint</function>
        </functions>
        <image>map/placeables/restaurant2/store_restaurant.png</image>
        <price>155000</price>
		<dailyUpkeep>500</dailyUpkeep>
        <canBeSold>false</canBeSold>
        <showInStore>false</showInStore>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>sellingPoints</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>sellingPoints</tab>
        </brush>
    </storeData>

    <base>
        <filename>map/placeables/restaurant2/restaurant.i3d</filename>
        <canBeRenamed>false</canBeRenamed>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
    </placement>

    <clearAreas>
    </clearAreas>

    <leveling requireLeveling="false" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30" >
    </leveling>

    <indoorAreas>
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01" />
        </updateAreas>
		<splines>
            <spline node="aiUnloadingSpline" />
        </splines>
    </ai>

    <hotspots>
        <hotspot type="UNLOADING" linkNode="unloadTriggerMarker" teleportNode="unloadTriggerMarker" />
    </hotspots>

    <sellingStation appearsOnStats="true" litersForFullPriceDrop="20000" fullPriceRecoverHours="48" supportsExtension="false">
        <palletTrigger triggerNode="palletTrigger" aiNode="unloadTriggerAINode" fillTypes="SPRING_ONION CHILLI ENOKI GARLIC TOMATO LETTUCE STRAWBERRY OYSTER HONEY EGG MILK_BOTTLED GOATMILK_BOTTLED BUFFALOMILK_BOTTLED BUTTER CHEESE GOATCHEESE BUFFALOMOZZARELLA CHOCOLATE FLOUR BREAD PASTA GNOCCHI TRICOLORE PASTAUOVO REDCABBAGE GRAPEJUICE_PREMIUM GRAPEJUICE_BUBBLE TABLEGRAPE" />
        
		<fillType name="TOMATO"           		priceScale="1.25" supportsGreatDemand="true" disablePriceDrop="false" />
        <fillType name="STRAWBERRY"           	priceScale="1.25" supportsGreatDemand="true" disablePriceDrop="false" />
		<fillType name="HONEY"           		priceScale="1.25" supportsGreatDemand="true" disablePriceDrop="false" />	
		<fillType name="CHOCOLATE"           	priceScale="1.25" supportsGreatDemand="true" disablePriceDrop="false" />
		<fillType name="CHILLI"      			priceScale="1.25" supportsGreatDemand="true" disablePriceDrop="false" />
		<fillType name="LETTUCE"      			priceScale="1.25" supportsGreatDemand="true" disablePriceDrop="false" />
		<fillType name="GARLIC"      			priceScale="1.25" supportsGreatDemand="true" disablePriceDrop="false" />
		<fillType name="EGG"      				priceScale="1.25" supportsGreatDemand="true" disablePriceDrop="false" />
		<fillType name="CHEESE"      			priceScale="1.25" supportsGreatDemand="true" disablePriceDrop="false" />
		<fillType name="GOATCHEESE"      		priceScale="1.25" supportsGreatDemand="true" disablePriceDrop="false" />
		<fillType name="BREAD"      			priceScale="1.25" supportsGreatDemand="true" disablePriceDrop="false" />
		<fillType name="PASTA"      			priceScale="1.25" supportsGreatDemand="true" disablePriceDrop="false" />
		<fillType name="GNOCCHI"      			priceScale="1.25" supportsGreatDemand="true" disablePriceDrop="false" />
		<fillType name="TRICOLORE"      		priceScale="1.25" supportsGreatDemand="true" disablePriceDrop="false" />
		<fillType name="PASTAUOVO"     			priceScale="1.25" supportsGreatDemand="true" disablePriceDrop="false" />
		<fillType name="GRAPEJUICE_PREMIUM"     priceScale="1.25" supportsGreatDemand="true" disablePriceDrop="false" />
		<fillType name="GRAPEJUICE_BUBBLE"      priceScale="1.25" supportsGreatDemand="true" disablePriceDrop="false" />
		<fillType name="TABLEGRAPE"      		priceScale="1.25" supportsGreatDemand="true" disablePriceDrop="false" />
    </sellingStation>

    <triggerMarkers>
        <triggerMarker node="unloadTriggerMarker" filename="$data/shared/assets/marker/markerIconUnload.i3d" adjustToGround="true" />
        <triggerMarker node="warningStripes01" adjustToGround="true" />
    </triggerMarkers>

    <i3dMappings>
        <i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>0|0" />
        <i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>0|0|0" />
        <i3dMapping id="warningStripes01" node="0>1|0" />
        <i3dMapping id="sellingStation" node="0>2" />
        <i3dMapping id="exactFillRootNode" node="0>2|0" />
        <i3dMapping id="palletTrigger" node="0>2|1" />
        <i3dMapping id="unloadTriggerMarker" node="0>2|2" />
        <i3dMapping id="unloadTriggerAINode" node="0>2|3" />
        <i3dMapping id="aiUnloadingSpline" node="0>2|4" />
    </i3dMappings>
</placeable>
