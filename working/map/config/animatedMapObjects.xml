	<animatedObjects>
		<!-- BGA -->
		<animatedObject index="BGAGate" >
            <animation duration="3.5">
                <part node="0">
                    <keyFrame time="0.0" rotation="180 180 180"/>
                    <keyFrame time="1.0" rotation="180 77 180"/>
                </part>
                <part node="1">
                    <keyFrame time="0.0" rotation="-180 -180 180"/>
                    <keyFrame time="1.0" rotation="-180 -77 180"/>
                </part>
			</animation>
			<controls triggerNode="2" posAction="ACTIVATE_HANDTOOL" posText="action_openGate" negText="action_closeGate"/>
			<!--<openingHours startTime="9" endTime="18" disableIfClosed="true" closedText="$l10n_closedText_default"/>-->
			<sounds>
				<moving linkNode="1" template="metalDoorSqueaksSmall" />
				<posEnd linkNode="1" template="metalDoorsOpen" />
				<negEnd linkNode="1" template="metalDoorCloseRandom" />
			</sounds>
        </animatedObject>
		
