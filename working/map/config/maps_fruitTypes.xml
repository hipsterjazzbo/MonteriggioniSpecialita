            <converter from="SOYBEAN" to="CHAFF" factor="4.0"/>
            <converter from="SORGHUM" to="CHAFF" factor="4.0"/>
            <converter from="POPLAR" to="WOODCHIPS" factor="3.0"/>
			<converter from="SILAGEMAIZE" to="CHAFF" factor="4.5"/>
            <converter from="VETCHRYE" to="CHAFF" factor="3.9"/>
            <converter from="GREENRYE" to="CHAFF" factor="3.9"/>
            <converter from="SESAME" to="CHAFF" factor="6.0"/>
			<converter from="FABABEAN" to="CHAFF" factor="4.0"/>
			<converter from="CHICKPEA" to="CHAFF" factor="4.0"/>
        </fruitTypeConverter>
