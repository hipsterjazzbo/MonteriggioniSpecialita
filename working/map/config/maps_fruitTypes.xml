            <converter from="VETCHRYE" to="GRASS_WINDROW" factor="1.8"/>
            <converter from="GREENRYE" to="GRASS_WINDROW" factor="1.8"/>     
            <converter from="RYE" to="STRAW" factor="1.0"/>
            <converter from="TRITICALE" to="STRAW" factor="1.0"/>
            <converter from="SPELT" to="STRAW" factor="1.0"/>
			<converter from="HUMUSACTIVE" to="GRASS_WINDROW" factor="1.0"/>
