<?xml version="1.0" encoding="utf-8"?>
<foliageType xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://validation.gdn.giants-software.com/xml/fs25/foliageType.xsd">
    <fruitType name="vetchRye" shownOnMap="true" useForFieldMissions="false">
        <mapColors default="0.209 0.089 0.332 1" colorBlind="0.6795 0.6867 0.7231 1"/>
        <windrow fillType="grass_windrow" litersPerSqm="1.0" cutFillType="BARLEY_CUT" windrowCutFactor="1.25"/>
        <harvest litersPerSqm="0.5332" cutHeight="0.35" chopperType="CHOPPER_MAIZE"/>
        <growth resetsSpray="true" growthRequiresLime="true"/>
        <soil lowDensityRequired="true" increasesDensity="false" consumesLime="true" startSprayLevel="0"/>
        <seeding directionSnapAngle="0" needsRolling="true" litersPerSqm="0.021328" isAvailable="true"/>
        <cultivation isAllowed="true"/>
        <mulcher chopperType="CHOPPER_STRAW"/>
    </fruitType>

    <!-- vetchRye

    0 1 2 3

    1 0 0 0 - invisible
    0 1 0 0 - green small
    1 1 0 0 - green small 2
    0 0 1 0 - green middle
    1 0 1 0 - green big
    0 1 1 0 - green big 2
    1 1 1 0 - harvest ready
    0 0 0 1 - dead
    1 0 0 1 - harvested (cut)

    -->
    <foliageLayer densityMapChannelOffset="0" numDensityMapChannels="4" plantSeparation="0.40 0.40" plantOffset="0 0" plantLayoutRotation="true" shapeSource="vetchRye.i3d" alignsToSun="false">
        <foliageStateDefaults distanceMapLayer="1" width="1" height="1" widthVariance="0.5" heightVariance="0.4" horizontalPositionVariance="0.25"/>
        <!-- default LOD distances etc -->
        <foliageLodDefaults lod="0" viewDistance="18" blendOutDistance="2" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1"/>
        <foliageLodDefaults lod="1" viewDistance="80" blendOutDistance="2" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1"/>
        <!-- 1 0 0 0 - invisible -->
        <foliageState name="invisible" isGrowing="true" allowsWeeding="true" allowsHoeing="true"/>
        <!-- 0 1 0 0 - green small -->
        <foliageState name="greenSmall" numBlocksPerUnit="3.2" height="0.3" width="0.5" distanceMap="distance/foliage_vetchRye_distance2_diffuse.png" isGrowing="true" allowsWeeding="true" allowsHoeing="true" fieldCourseLineHeight="0.3">
            <foliageShape>
                <foliageLod blockShape="0>0|0"/>
                <foliageLod blockShape="0>1|0"/>
                <!-- <foliageLod blockShape="0>1|0" /> -->
            </foliageShape>
        </foliageState>
        <!-- 1 1 0 0 - green small -->
        <foliageState name="greenSmall2" numBlocksPerUnit="3.2" height="0.5" width="0.6" distanceMap="distance/foliage_vetchRye_distance2_diffuse.png" isGrowing="true" allowsWeeding="true" allowsHoeing="true" fieldCourseLineHeight="0.3">
            <foliageShape>
                <foliageLod blockShape="0>0|0"/>
                <foliageLod blockShape="0>1|0"/>
                <!-- <foliageLod blockShape="0>1|0" /> -->
            </foliageShape>
        </foliageState>
        <!-- 0 0 1 0 - green middle -->
        <foliageState name="greenMiddle" numBlocksPerUnit="3" height="0.47" width="0.6" distanceMap="distance/foliage_vetchRye_distance3_diffuse.png" isGrowing="true" allowsWeeding="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.5">
            <foliageShape probability="10">
                <foliageLod blockShape="0>0|1"/>
                <foliageLod blockShape="0>1|1"/>
                <!-- <foliageLod blockShape="0>1|1" /> -->
            </foliageShape>            
			<foliageShape probability="5">
                <foliageLod blockShape="0>0|6"/>
                <foliageLod blockShape="0>0|7"/>
                <foliageLod blockShape="0>1|6"/>
            </foliageShape>
        </foliageState>
        <!-- 1 0 1 0 - green middle 2 -->
        <foliageState name="greenMiddle2" numBlocksPerUnit="3" height="0.8" width="0.6" distanceMap="distance/foliage_vetchRye_distance3_diffuse.png" isGrowing="true" allowsWeeding="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.5">
            <foliageShape probability="10">
                <foliageLod blockShape="0>0|1"/>
                <foliageLod blockShape="0>1|1"/>
                <!-- <foliageLod blockShape="0>1|1" /> -->
            </foliageShape>
			<foliageShape probability="5">
                <foliageLod blockShape="0>0|6"/>
                <foliageLod blockShape="0>0|7"/>
                <foliageLod blockShape="0>1|6"/>
            </foliageShape>
        </foliageState>
        <!-- 0 1 1 0 - green big -->
        <foliageState name="greenBig" numBlocksPerUnit="2.2" height="0.8" width="0.75" distanceMap="distance/foliage_vetchRye_distance4_diffuse.png" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.85">
            <foliageShape probability="10">
                <foliageLod blockShape="0>0|2"/>
                <foliageLod blockShape="0>1|2"/>
                <!-- <foliageLod blockShape="0>1|2" /> -->
            </foliageShape>
			<foliageShape probability="9">
                <foliageLod blockShape="0>0|8"/>
                <foliageLod blockShape="0>0|9"/>
                <foliageLod blockShape="0>1|7"/>
            </foliageShape>
        </foliageState>
        <!-- 1 1 1 0 - green big 2 -->
        <foliageState name="greenBig2" numBlocksPerUnit="2.4" height="1.0" width="0.85" distanceMap="distance/foliage_vetchRye_distance4_diffuse.png" isGrowing="true" isForageReady="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.85">
            <foliageShape probability="10">
                <foliageLod blockShape="0>0|2"/>
                <foliageLod blockShape="0>1|2"/>
                <!-- <foliageLod blockShape="0>1|2" /> -->
            </foliageShape>
			<foliageShape probability="9">
                <foliageLod blockShape="0>0|8"/>
                <foliageLod blockShape="0>0|9"/>
                <foliageLod blockShape="0>1|7"/>
            </foliageShape>
        </foliageState>
        <!-- 0 0 0 1 - harvest ready-->
        <foliageState name="harvestReady" numBlocksPerUnit="2.2" height="1.1" width="1.3" distanceMap="distance/foliage_vetchRye_distance5_diffuse.png" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" isHarvestReady="true" groundType="HARVEST_READY" fieldCourseLineHeight="1">
            <foliageShape probability="10">
                <foliageLod blockShape="0>0|3"/>
                <foliageLod blockShape="0>1|3"/>
                <!-- <foliageLod blockShape="0>1|3" /> -->
            </foliageShape>
			<foliageShape probability="9">
                <foliageLod blockShape="0>0|10"/>
                <foliageLod blockShape="0>0|11"/>
                <foliageLod blockShape="0>1|8"/>
            </foliageShape>
        </foliageState>
        <!-- 1 0 0 1 - dead -->
        <foliageState name="dead" numBlocksPerUnit="1.4" height="1.0" width="0.8" distanceMap="distance/foliage_vetchRye_distance6_diffuse.png" isWithered="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.85">
            <foliageShape>
                <foliageLod blockShape="0>0|4"/>
                <foliageLod blockShape="0>1|4"/>
                <!-- <foliageLod blockShape="0>1|4" /> -->
            </foliageShape>
        </foliageState>
        <!-- 1 1 1 1 - tire tracks (harvested) -->
		 <foliageState name="tireTracks" numBlocksPerUnit="2.2" height="0.2" distanceMap="distance/foliage_vetchRye_distance7_diffuse.png" isCut="false" isDestructibleByWheel="false" isDestructedByWheel="true" isDestructibleByDisaster="true">
            <foliageShape probability="10">
                <foliageLod blockShape="0>0|5"/>
                <foliageLod blockShape="0>1|5"/>
                <!-- <foliageLod blockShape="0>1|5" /> -->
            </foliageShape>
			<foliageShape probability="10">
                <foliageLod blockShape="0>0|12"/>
                <foliageLod blockShape="0>1|9"/>
            </foliageShape>
        </foliageState>
        <!-- 0 1 0 1 - harvested (cut) -->
        <foliageState name="harvested" numBlocksPerUnit="2.2"  distanceMap="distance/foliage_vetchRye_distance7_diffuse.png" isCut="true" isDestructibleByWheel="true" isDestructibleByDisaster="true">
            <foliageShape probability="10">
                <foliageLod blockShape="0>0|5"/>
                <foliageLod blockShape="0>1|5"/>
                <!-- <foliageLod blockShape="0>1|5" /> -->
            </foliageShape>
			<foliageShape probability="10">
                <foliageLod blockShape="0>0|12"/>
                <foliageLod blockShape="0>1|9"/>
            </foliageShape>
        </foliageState>
        
    </foliageLayer>

    <growth>
        <seasonal>
           <period name="EARLY_SPRING">
				<update startState="greenBig2" endState="harvestReady" />
            </period>
            <period name="MID_SPRING"> 
				<update startState="harvestReady" endState="dead" />
            </period>
            <period name="LATE_SPRING" /> 
            <period name="EARLY_SUMMER" /> 
            <period name="MID_SUMMER" /> 
            <period name="LATE_SUMMER" /> 
            <period name="EARLY_AUTUMN" plantingAllowed="true"> 
				<update startState="invisible" endState="greenSmall2" />
            </period>
            <period name="MID_AUTUMN" plantingAllowed="true"> 
				<update startState="greenSmall2" endState="greenMiddle2" />
				<update startState="invisible" endState="greenSmall2" />
            </period>
            <period name="LATE_AUTUMN" > 
				<update startState="greenSmall2" endState="greenMiddle2" />
			</period>
            <period name="EARLY_WINTER" /> 
            <period name="MID_WINTER" /> 
            <period name="LATE_WINTER">	
				<update startState="greenMiddle2" endState="greenBig2" />
            </period>
        </seasonal>
    </growth>
</foliageType>
