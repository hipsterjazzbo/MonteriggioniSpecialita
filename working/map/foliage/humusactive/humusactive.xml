<?xml version="1.0" encoding="utf-8"?>
<foliageType xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://validation.gdn.giants-software.com/xml/fs25/foliageType.xsd">
    <fruitType name="humusactive" shownOnMap="true" useForFieldMissions="false" isCatchCrop="true">
        <mapColors default="0.056 0.250 0.141 1" colorBlind="0.0130 0.0908 0.5210 1"/>
        <harvest litersPerSqm="0.99" groundType="GRASS_CUT"/>
        <growth resetsSpray="true" growthRequiresLime="true"/>
        <soil lowDensityRequired="false" increasesDensity="false" consumesLime="false" startSprayLevel="0"/>
        <seeding directionSnapAngle="0" litersPerSqm="0.004" isAvailable="true" plantsWeed="false"/>
        <cultivation isAllowed="true"/>
    </fruitType>

    <!-- oilseed radish -->
    <foliageLayer densityMapChannelOffset="0" numDensityMapChannels="4" numBlocksPerUnit="1.8" shapeSource="humusactive.i3d" alignsToSun="false">
        <foliageStateDefaults distanceMapLayer="1" width="1.0" height="1.0" widthVariance="0.1" heightVariance="0.2" horizontalPositionVariance="0.1"/>
        <!-- default LOD distances etc -->
        <foliageLodDefaults lod="0" viewDistance="18" blendOutDistance="2" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1"/>
        <foliageLodDefaults lod="1" viewDistance="80" blendOutDistance="2" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1"/>
        <!-- 1 0 0 0 - invisible -->
        <foliageState name="invisible" isGrowing="true" isDestructibleByDisaster="false"/>
        <!-- 0 1 0 0 - green small -->
        <foliageState name="greenSmall" numBlocksPerUnit="3.2" distanceMap="distance/foliage_humusactive2_diffuse.png" isGrowing="true" isDestructedByWheel="true" isDestructibleByDisaster="false" fieldCourseLineHeight="0.3" regrowthStart="true" groundType="GRASS" groundTypeMask="GRASS GRASS_CUT SOWN DIRECT_SOWN ROLLER_LINES">
            <foliageShape>
                <foliageLod blockShape="0>0|0"/>
                <foliageLod blockShape="0>1|0"/>
            </foliageShape>            
			<foliageShape>
                <foliageLod blockShape="0>0|1"/>
                <foliageLod blockShape="0>1|1"/>
            </foliageShape>			
			<foliageShape>
                <foliageLod blockShape="0>0|2"/>
                <foliageLod blockShape="0>1|2"/>
            </foliageShape>			
			<foliageShape>
                <foliageLod blockShape="0>0|3"/>
                <foliageLod blockShape="0>1|3"/>
            </foliageShape>			
			<foliageShape>
                <foliageLod blockShape="0>0|4"/>
                <foliageLod blockShape="0>1|4"/>
            </foliageShape>
        </foliageState>
		<!-- 1 1 0 0 - green middle -->
        <foliageState name="greenMiddle" numBlocksPerUnit="2.8" height="1.2" heightVariance="0.3" widthVariance="0.2" distanceMap="distance/foliage_humusactive3_diffuse.png" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.5">
            <foliageShape>
                <foliageLod blockShape="0>0|0"/>
                <foliageLod blockShape="0>1|0"/>
            </foliageShape>
			<foliageShape>
                <foliageLod blockShape="0>0|1"/>
                <foliageLod blockShape="0>1|1"/>
            </foliageShape>			
			<foliageShape>
                <foliageLod blockShape="0>0|2"/>
                <foliageLod blockShape="0>1|2"/>
            </foliageShape>			
			<foliageShape>
                <foliageLod blockShape="0>0|3"/>
                <foliageLod blockShape="0>1|3"/>
            </foliageShape>				
			<foliageShape>
                <foliageLod blockShape="0>0|5"/>
                <foliageLod blockShape="0>1|5"/>
            </foliageShape>				
			<foliageShape>
                <foliageLod blockShape="0>0|6"/>
                <foliageLod blockShape="0>1|6"/>
            </foliageShape>				
			<foliageShape>
                <foliageLod blockShape="0>0|7"/>
                <foliageLod blockShape="0>1|7"/>
            </foliageShape>				
			<foliageShape>
                <foliageLod blockShape="0>0|10"/>
                <foliageLod blockShape="0>1|10"/>
            </foliageShape>	
        </foliageState>
        <!-- 1 1 0 0 - harvest ready -->
        <foliageState name="harvestReady" numBlocksPerUnit="2.8" height="2.2" heightVariance="0.3" widthVariance="0.2" distanceMap="distance/foliage_humusactive3_diffuse.png" isGrowing="true" isHarvestReady="true" yieldScale="0.4" isDestructibleByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="1">
            <foliageShape>
                <foliageLod blockShape="0>0|0"/>
                <foliageLod blockShape="0>1|0"/>
            </foliageShape>
			<foliageShape>
                <foliageLod blockShape="0>0|1"/>
                <foliageLod blockShape="0>1|1"/>
            </foliageShape>			
			<foliageShape>
                <foliageLod blockShape="0>0|2"/>
                <foliageLod blockShape="0>1|2"/>
            </foliageShape>			
			<foliageShape>
                <foliageLod blockShape="0>0|3"/>
                <foliageLod blockShape="0>1|3"/>
            </foliageShape>				
			<foliageShape>
                <foliageLod blockShape="0>0|5"/>
                <foliageLod blockShape="0>1|5"/>
            </foliageShape>				
			<foliageShape>
                <foliageLod blockShape="0>0|6"/>
                <foliageLod blockShape="0>1|6"/>
            </foliageShape>				
			<foliageShape>
                <foliageLod blockShape="0>0|7"/>
                <foliageLod blockShape="0>1|7"/>
            </foliageShape>				
			<foliageShape>
                <foliageLod blockShape="0>0|10"/>
                <foliageLod blockShape="0>1|10"/>
            </foliageShape>	
        </foliageState>
		<!-- 1 1 1 0 - withered-->
        <foliageState name="withered" numBlocksPerUnit="2.4" height="1.5" heightVariance="0.4" widthVariance="0.1" distanceMap="distance/foliage_humusactive4_diffuse.png" isWithered="true" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" isHarvestReady="true" fieldCourseLineHeight="0.5">
            <foliageShape>
                <foliageLod blockShape="0>0|0"/>
                <foliageLod blockShape="0>1|0"/>
            </foliageShape>            
			<foliageShape>
                <foliageLod blockShape="0>0|8"/>
                <foliageLod blockShape="0>1|8"/>
            </foliageShape>            
			<foliageShape>
                <foliageLod blockShape="0>0|9"/>
                <foliageLod blockShape="0>1|9"/>
            </foliageShape>			
			<foliageShape>
                <foliageLod blockShape="0>0|10"/>
                <foliageLod blockShape="0>1|10"/>
            </foliageShape>
        </foliageState>
        <!-- 1 1 1 1 - mulched -->
        <foliageState name="mulched" height="0.5" numBlocksPerUnit="3.0" isMulched="true" isGrowing="true" isDestructibleByWheel="false" isDestructibleByDisaster="false">
            <foliageShape>
                <foliageLod blockShape="0>0|11"/>
                <foliageLod blockShape="0>1|11"/>
            </foliageShape>
        </foliageState>
        <!-- 1 0 1 0 - cut -->
        <foliageState name="cut" numBlocksPerUnit="3.0" height="1.2" isCut="true" isDestructedByDisaster="true" isDestructibleByWheel="false">
            <foliageShape>
                <foliageLod blockShape="0>0|11"/>
                <foliageLod blockShape="0>1|11"/>
            </foliageShape>
        </foliageState>
    </foliageLayer>

    <growth>
        <seasonal initialState="greenSmall">
            <period name="EARLY_SPRING" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
                <update startState="mulched" endState="greenSmall" />
                <update startState="cut" endState="greenSmall" />
            </period>
            <period name="MID_SPRING" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
                <update startState="greenSmall" endState="greenMiddle" />
                <update startState="mulched" endState="greenSmall" />
                <update startState="cut" endState="greenSmall" />
            </period>
            <period name="LATE_SPRING" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
                <update startState="greenSmall" endState="greenMiddle" />
                <update startState="mulched" endState="greenSmall" />
                <update startState="cut" endState="greenSmall" />
            </period>
            <period name="EARLY_SUMMER" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
                <update startState="greenSmall" endState="greenMiddle" />
                <update startState="greenMiddle" endState="harvestReady" />
                <update startState="mulched" endState="greenSmall" />
                <update startState="cut" endState="greenSmall" />
            </period>
            <period name="MID_SUMMER" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
                <update startState="greenSmall" endState="greenMiddle" />
                <update startState="greenMiddle" endState="harvestReady" />
                <update startState="mulched" endState="greenSmall" />
                <update startState="cut" endState="greenSmall" />
            </period>
            <period name="LATE_SUMMER" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
                <update startState="greenSmall" endState="greenMiddle" />
                <update startState="greenMiddle" endState="harvestReady" />
                <update startState="mulched" endState="greenSmall" />
                <update startState="cut" endState="greenSmall" />
            </period>
            <period name="EARLY_AUTUMN" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
                <update startState="greenSmall" endState="greenMiddle" />
                <update startState="greenMiddle" endState="harvestReady" />
                <update startState="mulched" endState="greenSmall" />
                <update startState="cut" endState="greenSmall" />
            </period>
            <period name="MID_AUTUMN" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
                <update startState="greenSmall" endState="greenMiddle" />
                <update startState="greenMiddle" endState="harvestReady" />
                <update startState="mulched" endState="greenSmall" />
                <update startState="cut" endState="greenSmall" />
            </period>
            <period name="LATE_AUTUMN" >
			    <update startState="harvestReady" endState="withered" />
                <update startState="greenSmall" endState="greenMiddle" />
                <update startState="mulched" endState="greenSmall" />
                <update startState="cut" endState="greenSmall" />
			</period>
            <period name="EARLY_WINTER" >
                <update startState="greenMiddle" endState="withered" />
            </period>
            <period name="MID_WINTER" />
            <period name="LATE_WINTER" >
                <update startState="withered" endState="greenSmall" />
                <update startState="greenSmall" endState="greenMiddle" />
                <update startState="mulched" endState="greenSmall" />
                <update startState="cut" endState="greenSmall" />
            </period>
        </seasonal>
    </growth>

</foliageType>
