<?xml version="1.0" encoding="utf-8"?>
<foliageType xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../shared/xml/schema/foliageType.xsd">
    <fruitType name="lavender" shownOnMap="true" useForFieldMissions="true">
        <mapColors default="0.0908 0.004 0.1301 1" colorBlind="0.0546 0.0818 0.2789 1"/>
        <harvest litersPerSqm="5.2" cutHeight="0.3" forageCutHeight="0.4" chopperType="CHOPPER_STRAW"/>
        <growth resetsSpray="true" growthRequiresLime="true"/>
        <soil lowDensityRequired="true" increasesDensity="false" consumesLime="true" startSprayLevel="0"/>
        <seeding directionSnapAngle="0" needsRolling="true" seedUsagePerSqm="0.05" isAvailable="true"/>
        <cultivation isAllowed="true"/>
        <mulcher chopperType="CHOPPER_MAIZE"/>
    </fruitType>
    <!-- lavender

    5 6 7 8

    1 0 0 0 - 1 - invisible
    0 1 0 0 - 2 - green small
    1 1 0 0 - 3 - green middle
    0 0 1 0 - 4 - green big
    1 0 1 0 - 5 - harvest ready
    0 1 1 0 - 6 - cut
    1 1 1 0 - 7 - dead

    -->
    <foliageLayer cellSize="8" objectMask="16711935" decalLayer="0" densityMapChannelOffset="0" numDensityMapChannels="4" numBlocksPerUnit="0.5" shapeSource="lavender.i3d">
        <foliageStateDefaults distanceMapLayer="1" width="2.4" height="2.5" widthVariance="0" heightVariance="0.25" horizontalPositionVariance="0" />
        
<!-- default LOD distances etc -->
        <foliageLodDefaults lod="0" viewDistance="40"  blendOutDistance="2" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1" />
        <foliageLodDefaults lod="1" viewDistance="80" blendOutDistance="2" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1" />
        
<!-- 1 0 0 0 - invisible -->
        <foliageState name="invisible" isGrowing="true" allowsWeeding="true" allowsHoeing="true" isMulched="true" />
       
 <!-- 0 1 0 0 - green small -->
        <foliageState name="greenSmall" width="1" height="1" distanceMap="distance/foliage_lavender_distance2_diffuse.dds" groundType="HARVEST_READY_OTHER" isGrowing="true" allowsWeeding="true" allowsHoeing="true" fieldCourseLineHeight="0.3">
            <foliageShape>
                <foliageLod blockShape="0>0|0" />
                <foliageLod blockShape="1>0|0" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|1" />
                <foliageLod blockShape="1>0|1" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|2" />
                <foliageLod blockShape="1>0|2" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|3" />
                <foliageLod blockShape="1>0|3" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|4" />
                <foliageLod blockShape="1>0|4" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|5" />
                <foliageLod blockShape="1>0|5" />
            </foliageShape>
        </foliageState>
        
<!-- 1 1 0 0 - green middle -->
        <foliageState name="greenMiddle" width="2" height="2" distanceMap="distance/foliage_lavender_distance2_diffuse.dds" isGrowing="true" allowsWeeding="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.3">
            <foliageShape>
                <foliageLod blockShape="0>0|0" />
                <foliageLod blockShape="1>0|0" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|1" />
                <foliageLod blockShape="1>0|1" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|2" />
                <foliageLod blockShape="1>0|2" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|3" />
                <foliageLod blockShape="1>0|3" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|4" />
                <foliageLod blockShape="1>0|4" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|5" />
                <foliageLod blockShape="1>0|5" />
            </foliageShape>
        </foliageState>
       
<!-- 0 0 1 0 - green big -->
        <foliageState name="greenBig" distanceMap="distance/foliage_lavender_distance2_diffuse.dds" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.3"> 
            <foliageShape>
                <foliageLod blockShape="0>0|0" />
                <foliageLod blockShape="1>0|0" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|1" />
                <foliageLod blockShape="1>0|1" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|2" />
                <foliageLod blockShape="1>0|2" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|3" />
                <foliageLod blockShape="1>0|3" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|4" />
                <foliageLod blockShape="1>0|4" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|5" />
                <foliageLod blockShape="1>0|5" />
            </foliageShape>
        </foliageState>
        
<!-- 1 0 1 0 - harvest ready -->
        <foliageState name="harvestReady" distanceMap="distance/foliage_lavender_distance4_diffuse.dds" isDestructibleByWheel="true" isDestructibleByDisaster="true" isHarvestReady="true" fieldCourseLineHeight="0.3">
            <foliageShape>
                <foliageLod blockShape="0>3|0" />
                <foliageLod blockShape="1>3|0" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>3|1" />
                <foliageLod blockShape="1>3|1" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>3|2" />
                <foliageLod blockShape="1>3|2" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>3|3" />
                <foliageLod blockShape="1>3|3" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>3|4" />
                <foliageLod blockShape="1>3|4" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>3|5" />
                <foliageLod blockShape="1>3|5" />
            </foliageShape>
        </foliageState>     
      
<!-- 0 1 1 0 - cut -->
        <foliageState name="cut" width="2.2" height="2.2" heightVariance="0" distanceMap="distance/foliage_lavender_distance2_diffuse.dds" isCut="true"  isGrowing="true" isDestructedByWheel="true" isDestructedByDisaster="true">
            <foliageShape>
                <foliageLod blockShape="0>0|0" />
                <foliageLod blockShape="1>0|0" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|1" />
                <foliageLod blockShape="1>0|1" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|2" />
                <foliageLod blockShape="1>0|2" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|3" />
                <foliageLod blockShape="1>0|3" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|4" />
                <foliageLod blockShape="1>0|4" />
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|5" />
                <foliageLod blockShape="1>0|5" />
            </foliageShape>
        </foliageState>
        
    </foliageLayer>

<growth>
	<seasonal initialState="greenMiddle">
		<period name="EARLY_SPRING" plantingAllowed="true">
        <update startState="invisible" endState="greenSmall" />
        <update startState="cut" endState="greenSmall" />
		</period>
		<period name="MID_SPRING" plantingAllowed="true">
        <update startState="greenSmall" endState="greenMiddle" />
        <update startState="greenMiddle" endState="greenBig" />
		</period>
		<period name="LATE_SPRING">
        <update startState="greenSmall" endState="greenMiddle" />
        <update startState="greenMiddle" endState="greenBig" />
		</period>
		<period name="EARLY_SUMMER">
        <update startState="greenBig" endState="harvestReady" />
		</period>
		<period name="MID_SUMMER">
        <update startState="greenBig" endState="harvestReady" />
		</period>
		<period name="LATE_SUMMER">
        <update startState="greenBig" endState="harvestReady" />
		</period>
		<period name="EARLY_AUTUMN">
        <update startState="harvestReady" endState="cut" />
		</period>
		<period name="MID_AUTUMN"/>
        <!-- Nach Rückschnitt nichts mehr -->
		<period name="LATE_AUTUMN">
        <!-- optional: knock back bei ausbleibendem Schnitt -->
        <update startState="harvestReady" endState="cut" />
		</period>
		<period name="EARLY_WINTER" />
		<period name="MID_WINTER" />
		<period name="LATE_WINTER" />
	</seasonal>
	
	<nonSeasonal>
            <update startState="invisible" endState="greenSmall" />
            <update startState="greenSmall" endState="greenMiddle" />
            <update startState="greenMiddle" endState="harvestReady" />
            <update startState="cut" endState="greenSmall" />
    </nonSeasonal>

</growth>

</foliageType>
