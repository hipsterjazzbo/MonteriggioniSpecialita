<?xml version="1.0" encoding="utf-8"?>
<foliageType xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://validation.gdn.giants-software.com/xml/fs25/foliageType.xsd">
    <fruitType name="potato" shownOnMap="true" useForFieldMissions="false">
        <mapColors default="0.2622 0.1248 0.0782 1" colorBlind="0.7991 0.7304 0.3419 1"/>
        <harvest litersPerSqm="2.942000" beeYieldBonusPercentage="0.05" groundType="SOWN"/>
        <growth resetsSpray="true" growthRequiresLime="true"/>
        <soil lowDensityRequired="true" increasesDensity="true" consumesLime="true" startSprayLevel="0"/>
        <seeding directionSnapAngle="22.5" needsRolling="false" litersPerSqm="0.357143" isAvailable="true" defaultSowingGroundType="RIDGE_SOWN"/>
        <cultivation isAllowed="true"/>
        <haulm layerName="potato_haulm"/>
    </fruitType>

    <!-- potato

    0 1 2 3

    1 0 0 0 - invisible
    0 1 0 0 - green small
    1 1 0 0 - green small 2
    0 0 1 0 - green middle
    1 0 1 0 - green big
    0 1 1 0 - harvest ready
    1 1 1 0 - dead
    0 0 0 1 - harvested (extructed)
    1 0 0 1 - cut haulm (not extructed)

    -->
    <foliageLayer densityMapChannelOffset="0" numDensityMapChannels="4" plantSeparation="0.75 0.55" plantOffset="0 0" plantLayoutRotation="true" shapeSource="potato.i3d" alignsToSun="false">
        <foliageStateDefaults distanceMapLayer="1" width="0.8" height="0.8" widthVariance="0.3" heightVariance="0.3" horizontalPositionVariance="0.15"/>
        <!-- default LOD distances etc -->
        <foliageLodDefaults lod="0" viewDistance="18" blendOutDistance="2" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1"/>
        <foliageLodDefaults lod="1" viewDistance="80" blendOutDistance="2" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1"/>
        <!-- 1 0 0 0 - invisible -->
        <foliageState name="invisible" isGrowing="true" allowsHoeing="true"/>
        <!-- 0 1 0 0 - green small -->
        <foliageState name="greenSmall" height="0.6" distanceMap="distance/foliage_potato_distance2_diffuse.png" isGrowing="true" allowsHoeing="true" fieldCourseLineHeight="0.25">
            <foliageShape>
                <foliageLod blockShape="0>0|0|0"/>
                <foliageLod blockShape="0>1|0"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|0|1"/>
                <foliageLod blockShape="0>1|0"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|0|2"/>
                <foliageLod blockShape="0>1|0"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|0|3"/>
                <foliageLod blockShape="0>1|0"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|0|4"/>
                <foliageLod blockShape="0>1|0"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|0|5"/>
                <foliageLod blockShape="0>1|0"/>
            </foliageShape>
        </foliageState>
        <!-- 1 1 0 0 - green small 2 -->
        <foliageState name="greenSmall2" distanceMap="distance/foliage_potato_distance2_diffuse.png" isGrowing="true" allowsHoeing="true" fieldCourseLineHeight="0.25">
            <foliageShape>
                <foliageLod blockShape="0>0|0|0"/>
                <foliageLod blockShape="0>1|0"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|0|1"/>
                <foliageLod blockShape="0>1|0"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|0|2"/>
                <foliageLod blockShape="0>1|0"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|0|3"/>
                <foliageLod blockShape="0>1|0"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|0|4"/>
                <foliageLod blockShape="0>1|0"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|0|5"/>
                <foliageLod blockShape="0>1|0"/>
            </foliageShape>
        </foliageState>
        <!-- 0 0 1 0 - green middle -->
        <foliageState name="greenMiddle" distanceMap="distance/foliage_potato_distance3_diffuse.png" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.35">
            <foliageShape>
                <foliageLod blockShape="0>0|1|0"/>
                <foliageLod blockShape="0>1|1"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|1|1"/>
                <foliageLod blockShape="0>1|1"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|1|2"/>
                <foliageLod blockShape="0>1|1"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|1|3"/>
                <foliageLod blockShape="0>1|1"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|1|4"/>
                <foliageLod blockShape="0>1|1"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|1|5"/>
                <foliageLod blockShape="0>1|1"/>
            </foliageShape>
        </foliageState>
        <!-- 1 0 1 0 - green big -->
        <foliageState name="greenBig" distanceMap="distance/foliage_potato_distance4_diffuse.png" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.55">
            <foliageShape>
                <foliageLod blockShape="0>0|2|0"/>
                <foliageLod blockShape="0>1|2"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|2|1"/>
                <foliageLod blockShape="0>1|2"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|2|2"/>
                <foliageLod blockShape="0>1|2"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|2|3"/>
                <foliageLod blockShape="0>1|2"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|2|4"/>
                <foliageLod blockShape="0>1|2"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|2|5"/>
                <foliageLod blockShape="0>1|2"/>
            </foliageShape>
        </foliageState>
        <!-- 0 1 1 0 - harvest ready -->
        <foliageState name="harvestReady" height="1.7" distanceMap="distance/foliage_potato_distance5_diffuse.png" isGrowing="true" isDestructibleByWheel="false" isDestructibleByDisaster="true" isPreparable="true" fieldCourseLineHeight="0.55">
            <foliageShape>
                <foliageLod blockShape="0>0|4|0"/>
                <foliageLod blockShape="0>1|4"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|4|1"/>
                <foliageLod blockShape="0>1|4"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|4|2"/>
                <foliageLod blockShape="0>1|4"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|4|3"/>
                <foliageLod blockShape="0>1|4"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|4|4"/>
                <foliageLod blockShape="0>1|4"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|4|5"/>
                <foliageLod blockShape="0>1|4"/>
            </foliageShape>
        </foliageState>
        <!-- 1 1 1 0 - dead -->
        <foliageState name="dead" height="1" distanceMap="distance/foliage_potato_distance6_diffuse.png" isWithered="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.2">
            <foliageShape>
                <foliageLod blockShape="0>0|4|0"/>
                <foliageLod blockShape="0>1|4"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|4|1"/>
                <foliageLod blockShape="0>1|4"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|4|2"/>
                <foliageLod blockShape="0>1|4"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|4|3"/>
                <foliageLod blockShape="0>1|4"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|4|4"/>
                <foliageLod blockShape="0>1|4"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|4|5"/>
                <foliageLod blockShape="0>1|4"/>
            </foliageShape>
        </foliageState>
        <!-- 0 0 0 1 - harvested -->
        <foliageState name="harvested" isCut="true" isDestructibleByWheel="false" isDestructedByWheel="true" isDestructedByDisaster="true"/>
        <!-- 1 0 0 1 - cut haulm -->
        <foliageState name="cutHaulm" isDestructibleByDisaster="true" isHarvestReady="true" isPrepared="true">
            <foliageShape>
                <foliageLod blockShape="0>0|5|0"/>
                <foliageLod blockShape="0>1|5"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|5|1"/>
                <foliageLod blockShape="0>1|5"/>
            </foliageShape>
            <foliageShape>
                <foliageLod blockShape="0>0|5|2"/>
                <foliageLod blockShape="0>1|5"/>
            </foliageShape>
        </foliageState>
    </foliageLayer>
    <!-- potato haulm -->
    <foliageLayer name="haulm" densityMapChannelOffset="4" numDensityMapChannels="1" numBlocksPerUnit="1.4" shapeSource="potatoHaulm.i3d">
        <foliageStateDefaults width="1.0" height="1.0" widthVariance="0" heightVariance="0" horizontalPositionVariance="0.1"/>
        <foliageLodDefaults lod="0" viewDistance="80"/>
        <foliageState distanceMapLayer="2" distanceMap="distance/foliage_potato_distance7_diffuse.png">
            <foliageShape>
                <foliageLod blockShape="0" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1"/>
            </foliageShape>
        </foliageState>
    </foliageLayer>

    <growth>
        <seasonal initialState="greenBig">
            <period name="EARLY_SPRING" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
            </period>
            <period name="MID_SPRING" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
                <update startState="greenSmall" endState="greenSmall2" />
            </period>
            <period name="LATE_SPRING">
                <update startState="greenSmall" endState="greenSmall2" />
                <update startState="greenSmall2" endState="greenMiddle" />
            </period>
            <period name="EARLY_SUMMER">
                <update startState="greenSmall2" endState="greenMiddle" />
                <update startState="greenMiddle" endState="greenBig" />
            </period>
            <period name="MID_SUMMER">
                <update startState="greenMiddle" endState="greenBig" />
                <update startState="greenBig" endState="harvestReady" />
            </period>
            <period name="LATE_SUMMER">
                <update startState="greenBig" endState="harvestReady" />
            </period>
            <period name="EARLY_AUTUMN">
                <update startState="harvestReady" endState="dead" />
            </period>
            <period name="MID_AUTUMN" />
            <period name="LATE_AUTUMN" />
            <period name="EARLY_WINTER" />
            <period name="MID_WINTER" />
            <period name="LATE_WINTER" />
        </seasonal>
    </growth>
</foliageType>
