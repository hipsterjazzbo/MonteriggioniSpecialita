<?xml version="1.0" encoding="utf-8"?>
<foliageType xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://validation.gdn.giants-software.com/xml/fs25/foliageType.xsd">

    <fruitType name="fieldGrass" shownOnMap="true" useForFieldMissions="false">
        <mapColors default="0.047 0.175 0.022 1" colorBlind="1.0000 0.9473 0.0369 1"/>
        <harvest litersPerSqm="2.63" groundType="GRASS_CUT"/>
        <windrow fillType="grass_windrow" />
        <growth resetsSpray="true" growthRequiresLime="false"/>
        <soil lowDensityRequired="false" increasesDensity="false" consumesLime="false" startSprayLevel="1"/>
        <seeding directionSnapAngle="0" litersPerSqm="0.012" isAvailable="true" plantsWeed="false"/>
        <cultivation isAllowed="true"/>
    </fruitType>
	
    <!-- fieldGrass

    0 1 2 3

    1 0 0 0 - invisible
    0 1 0 0 - green small
    1 1 0 0 - green middle
    0 0 1 0 - harvest ready
    1 0 1 0 - cut
    0 1 1 0 - cut 2

    -->
    <foliageLayer densityMapChannelOffset="0" numDensityMapChannels="4" numBlocksPerUnit="4.5" shapeSource="fieldGrass.i3d" alignsToSun="false">
        <foliageStateDefaults distanceMapLayer="1" width="1.0" height="1.2" widthVariance="0.3" heightVariance="0.7" horizontalPositionVariance="0.3"/>
        <!-- default LOD distances etc -->
        <foliageLodDefaults lod="0" viewDistance="18" blendOutDistance="2" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1"/>
        <foliageLodDefaults lod="1" viewDistance="80" blendOutDistance="2" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1"/>
        <!-- 1 0 0 0 - invisible -->
        <foliageState name="invisible" isGrowing="true" />
        <!-- 0 1 0 0 - green small -->
        <foliageState name="greenSmall1" height="0.6" numBlocksPerUnit="3.5" distanceMap="distance/foliage_fieldGrass_distance2_diffuse.png" isGrowing="true" isDestructibleByDisaster="false" >
            <foliageShape>
                <foliageLod blockShape="0>0|0"/>
                <foliageLod blockShape="0>1|0"/>
            </foliageShape>
        </foliageState>
        <!-- 0 1 0 0 - green small 2 -->
        <foliageState name="greenSmall" height="0.9" numBlocksPerUnit="3.5" distanceMap="distance/foliage_fieldGrass_distance2_diffuse.png" isGrowing="true" isHarvestReady="true" yieldScale="0.2" isDestructibleByDisaster="true" regrowthStart="true" groundType="GRASS" groundTypeMask="GRASS GRASS_CUT SOWN DIRECT_SOWN ROLLER_LINES" fieldCourseLineHeight="0.3">
            <foliageShape>
                <foliageLod blockShape="0>0|0"/>
                <foliageLod blockShape="0>1|0"/>
            </foliageShape>
        </foliageState>
        <!-- 0 1 0 0 - green small 3 -->
        <foliageState name="greenSmall3" height="1.2" numBlocksPerUnit="3.5" distanceMap="distance/foliage_fieldGrass_distance2_diffuse.png" isGrowing="true" isHarvestReady="true" yieldScale="0.4" isDestructibleByDisaster="true" fieldCourseLineHeight="0.3">
            <foliageShape>
                <foliageLod blockShape="0>0|0"/>
                <foliageLod blockShape="0>1|0"/>
            </foliageShape>
        </foliageState>
        <!-- 1 1 0 0 - green middle -->
        <foliageState name="greenMiddle" height="0.9" distanceMap="distance/foliage_fieldGrass_distance3_diffuse.png" isHarvestReady="true" yieldScale="0.6" isDestructedByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.3">
            <foliageShape>
                <foliageLod blockShape="0>0|1"/>
                <foliageLod blockShape="0>1|1"/>
            </foliageShape>
        </foliageState>
        <!-- 1 1 0 0 - green middle 2 -->
        <foliageState name="greenMiddle2" height="1.20" distanceMap="distance/foliage_fieldGrass_distance3_diffuse.png" isHarvestReady="true" yieldScale="0.8" isDestructibleByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.3">
            <foliageShape>
                <foliageLod blockShape="0>0|1"/>
                <foliageLod blockShape="0>1|1"/>
            </foliageShape>
        </foliageState>
        <!-- 0 0 1 0 - green big (harvest ready) -->
        <foliageState name="harvestReady" numBlocksPerUnit="2.8" height="1.50" distanceMap="distance/foliage_fieldGrass_distance4_diffuse.png" isHarvestReady="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.5">
            <foliageShape probability="3">
                <foliageLod blockShape="0>0|2"/>
                <foliageLod blockShape="0>1|2"/>
            </foliageShape>            
			<foliageShape probability="10">
                <foliageLod blockShape="0>0|3"/>
                <foliageLod blockShape="0>1|3"/>
            </foliageShape>
        </foliageState>
        <!-- 1 1 1 1 - mulched -->
        <foliageState name="mulched" height="0.5" numBlocksPerUnit="3.0" distanceMap="distance/foliage_fieldGrass_distance5_diffuse.png" isCut="true" isMulched="true" isGrowing="false" isDestructibleByWheel="false" isDestructibleByDisaster="false">
            <foliageShape>
                <foliageLod blockShape="0>0|4"/>
                <foliageLod blockShape="0>1|4"/>
            </foliageShape>
        </foliageState>
        <!-- 1 0 1 0 - cut -->
        <foliageState name="cut" numBlocksPerUnit="3.0" height="1.2" distanceMap="distance/foliage_fieldGrass_distance5_diffuse.png" isCut="true" isDestructedByDisaster="true" isDestructibleByWheel="false">
            <foliageShape>
                <foliageLod blockShape="0>0|4"/>
                <foliageLod blockShape="0>1|4"/>
            </foliageShape>
        </foliageState>
        <!-- 0 1 1 0 - cut rolled -->
        <foliageState name="cutRolled" numBlocksPerUnit="3.0" distanceMap="distance/foliage_fieldGrass_distance5_diffuse.png" isRolledCut="true" isDestructibleByWheel="false" isDestructibleByDisaster="false">
            <foliageShape>
                <foliageLod blockShape="0>0|5"/>
                <foliageLod blockShape="0>1|5"/>
            </foliageShape>
        </foliageState>
    </foliageLayer>
	
    <growth>
        <seasonal initialState="harvestReady">
            <period name="EARLY_SPRING" plantingAllowed="true">
                <update startState="greenSmall1" endState="greenSmall" />
                <update startState="invisible" endState="greenSmall" />
                <update startState="greenSmall" endState="greenSmall3" />
                <update startState="greenSmall3" endState="greenMiddle" />
                <update startState="greenMiddle" endState="greenMiddle2" />
                <update startState="greenMiddle2" endState="harvestReady" />
                <update startState="cut" endState="greenSmall" />
                <update startState="cutRolled" endState="greenSmall" />
                <update startState="mulched" endState="greenSmall" />
            </period>
            <period name="MID_SPRING" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
                <update startState="greenSmall" endState="greenSmall3" />
                <update startState="greenSmall3" endState="greenMiddle" />
                <update startState="greenMiddle" endState="greenMiddle2" />
                <update startState="greenMiddle2" endState="harvestReady" />
                <update startState="cut" endState="greenSmall" />
                <update startState="cutRolled" endState="greenSmall" />
                <update startState="mulched" endState="greenSmall" />
            </period>
            <period name="LATE_SPRING" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
                <update startState="greenSmall" endState="greenSmall3" />
                <update startState="greenSmall3" endState="greenMiddle" />
                <update startState="greenMiddle" endState="greenMiddle2" />
                <update startState="greenMiddle2" endState="harvestReady" />
                <update startState="cut" endState="greenSmall" />
                <update startState="cutRolled" endState="greenSmall" />
                <update startState="mulched" endState="greenSmall" />
            </period>
            <period name="EARLY_SUMMER" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
                <update startState="greenSmall" endState="greenSmall3" />
                <update startState="greenSmall3" endState="greenMiddle" />
                <update startState="greenMiddle" endState="greenMiddle2" />
                <update startState="greenMiddle2" endState="harvestReady" />
                <update startState="cut" endState="greenSmall" />
                <update startState="cutRolled" endState="greenSmall" />
                <update startState="mulched" endState="greenSmall" />
            </period>
            <period name="MID_SUMMER" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
                <update startState="greenSmall" endState="greenSmall3" />
                <update startState="greenSmall3" endState="greenMiddle" />
                <update startState="greenMiddle" endState="greenMiddle2" />
                <update startState="greenMiddle2" endState="harvestReady" />
                <update startState="cut" endState="greenSmall" />
                <update startState="cutRolled" endState="greenSmall" />
                <update startState="mulched" endState="greenSmall" />
            </period>
            <period name="LATE_SUMMER" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
                <update startState="greenSmall" endState="greenSmall3" />
                <update startState="greenSmall3" endState="greenMiddle" />
                <update startState="greenMiddle" endState="greenMiddle2" />
                <update startState="greenMiddle2" endState="harvestReady" />
                <update startState="cut" endState="greenSmall" />
                <update startState="cutRolled" endState="greenSmall" />
                <update startState="mulched" endState="greenSmall" />
            </period>
            <period name="EARLY_AUTUMN" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
                <update startState="greenSmall" endState="greenSmall3" />
                <update startState="greenSmall3" endState="greenMiddle" />
                <update startState="greenMiddle" endState="greenMiddle2" />
                <update startState="greenMiddle2" endState="harvestReady" />
                <update startState="cut" endState="greenSmall" />
                <update startState="cutRolled" endState="greenSmall" />
                <update startState="mulched" endState="greenSmall" />
            </period>
            <period name="MID_AUTUMN" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
                <update startState="greenSmall" endState="greenSmall3" />
                <update startState="greenSmall3" endState="greenMiddle" />
                <update startState="greenMiddle" endState="greenMiddle2" />
                <update startState="harvestReady" endState="greenMiddle2" /> <!-- knock back due to winter -->
                <update startState="cut" endState="greenSmall" />
                <update startState="cutRolled" endState="greenSmall" />
                <update startState="mulched" endState="greenSmall" />
            </period>
            <period name="LATE_AUTUMN" >
                <update startState="greenSmall" endState="greenSmall1" /> <!-- knock back due to winter -->
                <update startState="greenSmall3" endState="greenSmall1" /> <!-- knock back due to winter -->
                <update startState="greenMiddle" endState="greenSmall1" /> <!-- knock back due to winter -->
                <update startState="greenMiddle2" endState="greenSmall1" /> <!-- knock back due to winter -->
                <update startState="cut" endState="cut" />
                <update startState="cutRolled" endState="cutRolled" />
                <update startState="mulched" endState="mulched" />
            </period>
            <period name="EARLY_WINTER"/>
            <period name="MID_WINTER" />
            <period name="LATE_WINTER" plantingAllowed="true">
                <update startState="cut" endState="greenSmall1" />
                <update startState="cutRolled" endState="greenSmall" />
                <update startState="mulched" endState="greenSmall1" />
            </period>
        </seasonal>
    </growth>
</foliageType>
