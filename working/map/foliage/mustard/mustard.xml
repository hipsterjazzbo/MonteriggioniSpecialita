<?xml version="1.0" encoding="utf-8"?>
<foliageType xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://validation.gdn.giants-software.com/xml/fs25/foliageType.xsd">
    <fruitType name="mustard" shownOnMap="true" useForFieldMissions="false" isCatchCrop="true">
        <mapColors default="0.068 0.456 0.117 1" colorBlind="0.0130 0.0908 0.5210 1"/>
        <harvest litersPerSqm="0.99"/>
        <growth resetsSpray="true" growthRequiresLime="true"/>
        <soil lowDensityRequired="false" increasesDensity="false" consumesLime="false" startSprayLevel="0"/>
        <seeding directionSnapAngle="0" litersPerSqm="0.004" isAvailable="true" plantsWeed="false"/>
        <cultivation isAllowed="true"/>
    </fruitType>

    <!-- mustard -->
    <foliageLayer densityMapChannelOffset="0" numDensityMapChannels="4" numBlocksPerUnit="1.8" shapeSource="mustard.i3d" alignsToSun="false">
        <foliageStateDefaults distanceMapLayer="1" width="1.0" height="1.0" widthVariance="0" heightVariance="0.2" horizontalPositionVariance="0.5"/>
        <!-- default LOD distances etc -->
        <foliageLodDefaults lod="0" viewDistance="18" blendOutDistance="2" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1"/>
        <foliageLodDefaults lod="1" viewDistance="80" blendOutDistance="2" atlasSize="1" atlasOffset="1 0" texCoords="0 0 1 1"/>
        <!-- 1 0 0 0 - invisible -->
        <foliageState name="invisible" isGrowing="true"/>
        <!-- 0 1 0 0 - green small -->
        <foliageState name="greenSmall" numBlocksPerUnit="3.2" distanceMap="distance/foliage_mustard_distance2_diffuse.png" isGrowing="true" isDestructedByWheel="true" isDestructibleByDisaster="false" regrowthStart="true" groundType="HARVEST_READY_OTHER" fieldCourseLineHeight="0.25">
            <foliageShape probability="10">
                <foliageLod blockShape="0>0|0"/>
                <foliageLod blockShape="0>1|0"/>
            </foliageShape>            
			<foliageShape probability="6">
                <foliageLod blockShape="0>0|1"/>
                <foliageLod blockShape="0>1|1"/>
            </foliageShape>
        </foliageState>        
		<!-- 0 1 0 1 - green middle -->
        <foliageState name="greenMiddle" numBlocksPerUnit="2.6" distanceMap="distance/foliage_mustard_distance3_diffuse.png" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.25">
            <foliageShape probability="10">
                <foliageLod blockShape="0>0|0"/>
                <foliageLod blockShape="0>1|0"/>
            </foliageShape>            
			<foliageShape probability="6">
                <foliageLod blockShape="0>0|2"/>
                <foliageLod blockShape="0>1|2"/>
            </foliageShape>
        </foliageState>		
		<!-- 0 1 1 1 - harvest ready -->
        <foliageState name="harvestReady" numBlocksPerUnit="2.2" distanceMap="distance/foliage_mustard_distance4_diffuse.png" isGrowing="true" isHarvestReady="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" fieldCourseLineHeight="0.25">
            <foliageShape probability="8">
                <foliageLod blockShape="0>0|0"/>
                <foliageLod blockShape="0>1|0"/>
            </foliageShape>            
			<foliageShape probability="10">
                <foliageLod blockShape="0>0|3"/>
                <foliageLod blockShape="0>1|3"/>
            </foliageShape>
        </foliageState>		
		<!-- 1 1 1 1 - withered -->
        <foliageState name="withered" numBlocksPerUnit="2.2" distanceMap="distance/foliage_mustard_distance6_diffuse.png" isWithered="true" isGrowing="true" isDestructibleByWheel="true" isDestructibleByDisaster="true" isHarvestReady="true" fieldCourseLineHeight="0.25">
            <foliageShape probability="10">
                <foliageLod blockShape="0>0|0"/>
                <foliageLod blockShape="0>1|0"/>
            </foliageShape>            
			<foliageShape probability="5">
                <foliageLod blockShape="0>0|4"/>
                <foliageLod blockShape="0>1|4"/>
            </foliageShape>
        </foliageState>
        <!-- 1 1 1 1 - mulched -->
        <foliageState name="mulched" height="0.5" numBlocksPerUnit="3.0" isMulched="true" isGrowing="true" isDestructibleByWheel="false" isDestructibleByDisaster="false">
            <foliageShape>
                <foliageLod blockShape="0>0|5"/>
                <foliageLod blockShape="0>1|5"/>
            </foliageShape>
        </foliageState>
        <!-- 1 0 1 0 - cut -->
        <foliageState name="cut" isCut="true" isDestructedByDisaster="true" isDestructibleByWheel="false"/>
    </foliageLayer>

    <growth>
        <seasonal initialState="greenSmall">
            <period name="EARLY_SPRING" >
                <update startState="mulched" endState="greenSmall" />
            </period>
            <period name="MID_SPRING" >
                <update startState="greenSmall" endState="greenMiddle" />
				<update startState="greenMiddle" endState="harvestReady" />
                <update startState="mulched" endState="greenSmall" />
			</period>
            <period name="LATE_SPRING" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
                <update startState="greenSmall" endState="greenMiddle" />
				<update startState="greenMiddle" endState="harvestReady" />
                <update startState="mulched" endState="greenSmall" />
            </period>
            <period name="EARLY_SUMMER" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
                <update startState="greenSmall" endState="greenMiddle" />
				<update startState="greenMiddle" endState="harvestReady" />
                <update startState="mulched" endState="greenSmall" />
            </period>
            <period name="MID_SUMMER" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
                <update startState="greenSmall" endState="greenMiddle" />
				<update startState="greenMiddle" endState="harvestReady" />
                <update startState="mulched" endState="greenSmall" />
            </period>
            <period name="LATE_SUMMER" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
                <update startState="greenSmall" endState="greenMiddle" />
				<update startState="greenMiddle" endState="harvestReady" />
				<update startState="harvestReady" endState="withered" />
                <update startState="mulched" endState="greenSmall" />
            </period>
            <period name="EARLY_AUTUMN" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
                <update startState="greenSmall" endState="greenMiddle" />
				<update startState="greenMiddle" endState="harvestReady" />
				<update startState="harvestReady" endState="withered" />
                <update startState="mulched" endState="greenSmall" />
            </period>
            <period name="MID_AUTUMN" plantingAllowed="true">
                <update startState="invisible" endState="greenSmall" />
                <update startState="greenSmall" endState="greenMiddle" />
				<update startState="greenMiddle" endState="harvestReady" />
				<update startState="harvestReady" endState="withered" />
                <update startState="mulched" endState="greenSmall" />
            </period>
            <period name="LATE_AUTUMN" >
				<update startState="greenSmall" endState="greenMiddle" />
                <update startState="harvestReady" endState="withered" />
			</period>	
            <period name="EARLY_WINTER" >
                <update startState="greenMiddle" endState="greenSmall" />
            </period>
            <period name="MID_WINTER" />
            <period name="LATE_WINTER" >
                <update startState="mulched" endState="greenSmall" />
                <update startState="withered" endState="greenSmall" />
            </period>
        </seasonal>
    </growth>

</foliageType>
