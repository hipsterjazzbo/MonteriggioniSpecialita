  <Shapes externalShapesFile="newHollandDealerSignboard.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="newHollandDealerSignboard" nodeId="12">
      <Shape name="rod" translation="0 -0.25 0" shapeId="1" clipDistance="500" nodeId="13" castsShadows="true" receiveShadows="true" materialIds="61">
        <Shape name="signboard" translation="0.0133295 10.694 0" shapeId="2" clipDistance="500" nodeId="14" castsShadows="true" receiveShadows="true" materialIds="31">
          <Shape name="signboardCollision" shapeId="3" static="true" collisionFilterGroup="0x3e" collisionFilterMask="0xfffffbff" nodeId="15" castsShadows="false" receiveShadows="false" nonRenderable="true" distanceBlending="false" materialIds="5"/>
        </Shape>
        <Shape name="rodCollision" translation="0 5 0" shapeId="4" static="true" collisionFilterGroup="0x3e" collisionFilterMask="0xfffffbff" nodeId="16" castsShadows="false" receiveShadows="false" nonRenderable="true" distanceBlending="false" materialIds="5"/>
